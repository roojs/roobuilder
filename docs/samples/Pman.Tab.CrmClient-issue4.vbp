vbp-version = 1;
name = Pman.Tab.CrmClient;
parent = Pman.Tab.Crm;
permname = Crm.View_Email;
modOrder = 020;

Roo.NestedLayoutPanel {
  background = false;
  fitToFrame = true;
  layout = Roo.BorderLayout {
    center = Roo.LayoutRegion {
      tabPosition = "top";
      titlebar = false;
    }
    east = Roo.LayoutRegion {
      Boolean autoHide = false;
      Boolean collapsible = true;
      String title = "Person Name";
      listeners [
        collapsed function (_self)
        {
              _self.hide();
        }
,
        expanded function (_self)
        {
              _self.show();
        }
,
        slidehide function (_self)
        {
              _self.hide();
        }
,
        slideshow function (_self)
        {
              _self.clearMonitor(); // avoid sliding in when clicking on non-floating region
              this.el.setStyle("z-index", 8001); // show dialog on top of the region
              this.el.setStyle('box-shadow', "black 0 0 10px"); // add shadow
        }

      ]
    }
    [
      Roo.NestedLayoutPanel {
        background = true;
        fitContainer = true;
        fitToFrame = true;
        layout = Roo.BorderLayout {
          north = Roo.LayoutRegion {
            Boolean collapsible = true;
            Boolean split = true;
            Number height = 400;
            String collapsedTitle = "Show Action Required";
            String tabPosition = "top";
            String title = "Action Required";
          }
          center = Roo.LayoutRegion {
            String tabPosition = "top";
          }
          [
            Roo.GridPanel {
              Boolean background = true;
              fitContainer = true;
              fitToframe = true;
              grid = Roo.grid.Grid {
                String autoExpandColumn = "notes";
                toolbar = Roo.Toolbar {
                  [
                    Roo.Toolbar.Fill {},
                    Roo.Toolbar.Button {
                      listeners [
                        click function (_self, e)
                        {
                              var s = _this.actionRequiredGrid.getSelectionModel().getSelections();
                              
                              if (!s.length)  {
                                  Roo.MessageBox.alert("Error", "Select at least one Row");
                                  return;
                              }
                              
                              var actionIds = [];
                              Roo.each(s, function(selection) {
                                  actionIds.push(selection.data.id);
                              });
                              
                              Pman.Dialog.CrmContactAgainClear.show(
                                  {
                                      '_clear_contact_again_ids': actionIds
                                  },
                                  function() {
                                      _this.actionRequiredGrid.footer.onClick('first');
                                  }
                              );
                        }

                      ]
                      text = "Clear Contact Again / Enquiry";
                    }
                  ]
                }
                footer = Roo.PagingToolbar {
                  displayInfo = true;
                  displayMsg = "Displaying Activities {0} - {1} of {2}";
                  emptyMsg = "No Activity found";
                  [
                    Roo.Toolbar.Button {
                      menu = Roo.menu.Menu {
                        [
                          Roo.menu.Item {
                            listeners [
                              click function (_self, e)
                              {
                                    _this.statusBtn.setText(this.text.replace("Show", "Showing"));
                                    _this.statusFilter = 'valid';
                                    _this.actionRequiredGrid.footer.onClick('first'); 
                              }

                            ]
                            text = "Show only valid email addresses";
                          },
                          Roo.menu.Item {
                            listeners [
                              click function (_self, e)
                              {
                                    _this.statusBtn.setText(this.text.replace("Show", "Showing"));
                                    _this.statusFilter = 'invalid';
                                    _this.actionRequiredGrid.footer.onClick('first'); 
                              }

                            ]
                            text = "Show invalid email addresses";
                          },
                          Roo.menu.Item {
                            listeners [
                              click function (_self, e)
                              {
                                    _this.statusBtn.setText(this.text.replace("Show", "Showing"));
                                    _this.statusFilter = 'spam';
                                    _this.actionRequiredGrid.footer.onClick('first'); 
                              }

                            ]
                            text = "Show spam";
                          }
                        ]
                      }
                      listeners [
                        render function (_self)
                        {
                              _this.statusBtn = _self;
                              _this.statusFilter = 'valid';
                        }

                      ]
                      text = "Showing only valid email addresses";
                    }
                  ]
                  pageSize = 25;
                }
                dataSource = Roo.data.Store {
                  boolean remoteSort = true;
                  reader = Roo.data.JsonReader {
                    Array fields = [
    {
        'name': 'id',
        'type': 'int'
    }
]                    id = "id";
                    root = "data";
                    totalProperty = "total";
                  }
                  proxy = Roo.data.HttpProxy {
                    url = baseURL + '/Roo/Crm_action';
                    method = "GET";
                  }
                  listeners [
                    load function (_self, records, options)
                    {
                          Roo.each(records, record => record.set('isExpanded', -1), this);
                          _this.actionRequiredPanel.region.show();
                          if(!records.length) {
                              var northRegion =  _this.actionRequiredPanel.region;
                              // slide in if person region slided out
                              if(northRegion.isSlid) {
                                  northRegion.slideIn();
                                  return;
                              }
                              // collapse if expanded
                              if(!northRegion.collapsed) {
                                  northRegion.collapse();
                                  return;
                              }
                          }
                    }
,
                    update function (_self, record, operation)
                    {
                          if(operation != 'commit') {
                              return;
                          }
                          
                          new Pman.Request({
                              url : baseURL + '/Roo/crm_person.php',
                              method : 'POST',
                              params : {
                                  id: record.data.person_id,
                                  email_is_spam: record.data.person_id_email_is_spam
                              },
                              success : function(res) {
                                  _this.actionRequiredGrid.footer.onClick('first');
                              }
                          });
                    }
,
                    beforeload function (_self, options)
                    {
                          if(Pman.building) {
                              return false;
                          }
                          options.params = options.params || {};
                          
                          options.params['_action_required'] = 1;
                          
                          switch(_this.statusFilter) {
                              // hide invalid
                              // hide spam
                              case 'valid':
                                  options.params['_hide_invalid'] = 1;
                                  options.params['_hide_spam'] = 1;
                                  break;
                              // show invalid
                              // hide spam
                              case 'invalid':
                                  options.params['_invalid_only'] = 1;
                                  options.params['_hide_spam'] = 1;
                                  break;
                              // show spam only
                              case 'spam':
                                  options.params['_spam_only'] = 1;
                                  break;
                          }
                          
                          options.params['_exclude_columns'] = [
                              'core_person.*',
                              'crm_service_interest.*',
                              'Events.*'
                          ].join(',');
                    }

                  ]
                }
                cm[] = Roo.grid.ColumnModel {
                  Function renderer = function(v,x,r)
                  {
                        if(r.data.contact_again_notify_id * 1 != -1) {
                            return '';
                        }
                        
                        // is spam
                        // show a ticked checkbox
                        if(v * 1) {
                            return '<img class="x-grid-check-icon-checked" src="' + Roo.BLANK_IMAGE_URL + '"/>';
                        }
                        
                        // not spam
                        // show blue and underlined 'Is Spam'
                        return '<div style="color:blue; text-decoration:underline;">Is Spam?</div>'
                  }
                  String header = '<div class="fas fa-poop" style="color:brown;" qtip="Spam"></div>';
                  Number width = 60;
                  dataIndex = "person_id_email_is_spam";
                }
                cm[] = Roo.grid.ColumnModel {
                  Function renderer = function(v, x, r)
                  {
                        
                        // Contact Again (only when act_start is set)
                        if(
                            typeof(r.json.is_contact_again_row) != 'undefined' 
                            && 
                            r.json.is_contact_again_row * 1
                            && 
                            r.data.contact_again_notify_id_act_start != ""
                        ) {
                            var actStart = r.data.contact_again_notify_id_act_start;
                            var now = new Date();
                            now.setHours(0,0,0);
                            actStart.setHours(0,0,0);
                            
                            var color = 'background-color:red; color:white;';
                            if(actStart > now) {
                                color = 'color:green';
                            }
                            var date = actStart.format('d M Y');
                            var ret = String.format("<span style='font-weight:bold; {0}'>{1}</span>", color, date);
                            
                            return ret;
                        }
                        
                        // Enquiry / Sales Expected -> use action_dt
                        
                        var yest = (new Date()).add(Date.DAY, -6);
                        
                        var date = r.data.action_dt.format('D h:ia');
                        if (v < yest) {
                            date = r.data.action_dt.format('d M Y');
                        }
                        
                        var qtip = r.data.action_dt.format('d M Y h:ia');
                        
                        // Sales Expected -> red
                        var cls = r.data.action_type_id_name == 'EXPECTEDSALES' ? 'crm-red-tag' : '';
                        
                        var ret = String.format("<span qtip='{0}' class='{1}'>{2}</span>", qtip, cls, date);
                        
                        return r.data.deleted_by_id * 1 ? "<s>" + ret + "</s>" : ret;
                  }
                  Number width = 100;
                  String align = "right";
                  String header = "Contact When";
                  dataIndex = "action_dt";
                }
                cm[] = Roo.grid.ColumnModel {
                  Function renderer = function(v, x, r)
                  {
                        var isContactAgain = (
                            typeof(r.json.is_contact_again_row) != 'undefined' 
                            && 
                            r.json.is_contact_again_row * 1
                            && 
                            r.data.contact_again_notify_id_act_start != ""
                        );
                        
                        type = r.data.action_type_id_display_name;
                        
                        if(isContactAgain) {
                            var now = new Date();
                            now.setHours(0,0,0);
                            var actStart = r.data.contact_again_notify_id_act_start;
                            actStart.setHours(0,0,0);
                            
                            var color = 'background-color:red; color:white;';
                            if(actStart > now) {
                                color = 'color:green';
                            }
                            
                            type = String.format('<span style="font-weight:bold; {0}">Contact Again</span>', color);
                        }
                        
                        // sales expected -> red action name and show company name
                        if(r.data.action_type_id_name == 'EXPECTEDSALES') {
                            type = String.format('<span class="crm-red-tag">{1}</span> - {2} - <span class="crm-blue-link">Update</span>', 
                                color, 
                                r.data.action_type_id_display_name,
                                r.data.company_id_name
                            );
                        }
                        
                        // not assigned to any owner AND not sales expected
                        if(!(r.data.person_id_owner_id * 1) && r.data.action_type_id_name != 'EXPECTEDSALES') {
                            type += ' - <span style="font-weight: bold; background-color:red; color:white;">No one assigned</span>';
                        }
                        
                        // assigned to an old staff
                        if(r.data.is_assigned_to_old_staff * 1) {
                            var oldStaffInfo = ' - Old Staff (was ' + r.data.contact_again_notify_id_person_id_name + ')';
                            if(isContactAgain) {
                                oldStaffInfo = '<span style="font-weight: bold; background-color:red; color:white;">' + oldStaffInfo + '</span>';
                            }
                            type += oldStaffInfo;
                        }
                        
                        // show the name and the company of the person to be contacted
                        if(r.data.person_id_name) {
                            var personInfo = ' - ' + String.format('{0}', r.data.person_id_name);
                            if(r.data.person_id_company_id_name) {
                                personInfo = personInfo + ' (' + r.data.person_id_company_id_name + ')';
                            }
                            
                            // strikethrough if the contact is invalid (too many fails or bad email domain)
                            if(r.data.is_invalid_contact * 1) {
                                personInfo = '<span style="text-decoration: line-through;">' + personInfo + '</span>';
                            }
                            
                            type = type + ' ' + personInfo;
                        }
                        
                        var fullNotes = r.data.notes.replace(/\n/g,'<br/>');
                        
                        if(isContactAgain) {
                            fullNotes = r.data.action_dt.format('d M Y') + ' - ' + fullNotes;
                        }
                        
                        if(r.data.original_id * 1) {
                            fullNotes += '<div><s>' + r.data.original_id_notes.replace(/\n/g,'<br/>') + '</s></div>';
                        }
                        
                        var abbrNotes = r.data.action_dt.format('d M Y') + ' - ' + r.data.notes.substr(0,60) + '...';
                        
                        // show abbreivation only when the cell is collapsed AND (the note is long OR there is a old version)
                        var notes = (
                            r.get('isExpanded') === -1 // collapsed
                            &&
                            (
                                r.data.notes.length > 60 // long notes
                                ||
                                r.data.original_id_notes.length * 1 // with old version
                            )
                        ) ? abbrNotes : fullNotes;
                        
                        var ret = '<div style="font-weight:bold;">' + type + '</div><br/><div style="white-space:normal;">' + notes + '</div>';
                        return r.data.deleted_by_id * 1 ? '<s>' + ret + '</s>' : ret;
                  }
                  String header = "Activity";
                  dataIndex = "notes";
                }
                listeners [
                  cellclick function (_self, rowIndex, columnIndex, e)
                  {
                        r = _self.ds.getAt(rowIndex);
                        
                        if(columnIndex == 0) {
                            if(r.data.contact_again_notify_id * 1 != -1) {
                                return;
                            }
                            
                            var index = 'person_id_email_is_spam';
                            
                            if(r.data[index] * 1) {
                                r.set(index, 0);
                                r.commit();
                            }
                            else {
                                Roo.MessageBox.show({
                                    title: 'Warning',
                                    msg: 'Please confirm this enquiry is spam',
                                    buttons: {yes: 'Spam', no: 'Not Spam'},
                                    fn: function(res) {
                                        if(res != 'yes') {
                                            return;
                                        }
                                        r.set(index, 1);
                                        r.commit();
                                    }
                                });
                            }
                            return;
                        }
                        
                        if(columnIndex == 2) {
                            var r = _this.actionRequiredGrid.ds.getAt(rowIndex);
                            
                            setTimeout(() => r.set('isExpanded', r.get('isExpanded') * -1), 100);
                        }
                        
                        
                        var s = _self.getSelectionModel().getSelections();
                        
                        var eastRegion = _this.layout.getRegion('east');
                        var actionRequiredRegion = _this.layout.getRegion('center').getPanel(0).layout.getRegion('north');
                        
                        // no person is selected
                        // OR
                        // more than one person is selected
                        if(!s.length || s.length > 1) {
                            // slide in if person region slided out
                            if(eastRegion.isSlid) {
                                eastRegion.slideIn();
                            }
                            // collapse if expanded
                            if(!eastRegion.collapsed) {
                                eastRegion.collapse();
                            }
                            return;
                        }
                        
                        // only one person is selected
                        
                        var rec = _self.getSelectionModel().getSelected();
                        
                        // select sales expected actions with no person_id
                        // OR
                        // select the same perosn again
                        if(
                            rec.data.action_type_id_name == 'EXPECTEDSALES'
                            ||
                            typeof(_this.viewPerson) != 'undefined' && _this.viewPerson.id == rec.data.person_id
                        ) {
                            // slide in if person region slided out
                            if(eastRegion.isSlid) {
                                eastRegion.slideIn();
                                return;
                            }
                            // collapse if expanded
                            if(!eastRegion.collapsed) {
                                eastRegion.collapse();
                                return;
                            }
                        }
                        
                        // sales expected actions with no person_id -> filter the contacts by the company
                        if(rec.data.action_type_id_name == 'EXPECTEDSALES') {
                            if(rec.data.company_id * 1) {
                                var target = e.getTarget();
                                if(
                                    target.tagName.toLowerCase() == 'span' && 
                                    target.classList.contains('crm-blue-link') &&
                                    r.data.latest_last_contact_person_id * 1
                                ) {
                                    Pman.Dialog.CrmAction.show({
                                        person_id: r.data.latest_last_contact_person_id,
                                        action_type_id_name: 'NOTE', 
                                        company_id: r.data.company_id,
                                        owner_id: Pman.Login.authUser.id,
                                        owner_id_active: Pman.Login.authUser.active,
                                        owner_id_name: Pman.Login.authUser.name
                                    } , function() {
                                        _this.actionRequiredGrid.footer.onClick('first');
                                        _this.grid.footer.onClick('refresh');
                                    });
                                    return;
                                }
                                
                                if (!_this.filterPanel.region.visible || !_this.searchPanel.active) {
                                    _this.showHideFullSearch.fireEvent('click');
                                    _this.filterPanel.layout.getRegion('center').showPanel(0);
                                }
                                _this.companySel.setFromData({
                                    'id': rec.data.company_id,
                                    'name': rec.data.company_id_name
                                });
                                _this.grid.footer.onClick('first');
                            }
                            return;
                        }
                        
                        _this.viewPerson = Object.fromEntries(
                            Object.entries(rec.data)
                                .filter(([key]) => key.startsWith("person_id_")) // Keep only keys with "person_id_"
                                .map(([key, value]) => [key.replace("person_id_", ""), value]) // Remove prefix
                        );
                        
                        // DON't slide out if the person region is already expanded
                        if(eastRegion.collapsed) {
                            eastRegion.show();
                            if(actionRequiredRegion.isSlid) {
                                eastRegion.expand();
                            }
                            else {
                                eastRegion.slideOut();
                            }
                        }
                        
                        // load new person
                        eastRegion.titleTextEl.innerHTML = 
                            String.format('{0}',
                                (rec.data.person_id_honor.length ? rec.data.person_id_honor + '. ' : '') + rec.data.person_id_name
                            );
                        _this.viewPersonGrid.ds.load();
                  }
,
                  render function (grid)
                  {
                        _this.actionRequiredGrid = this;
                  }

                ]
                loadMask = true;
              }
              listeners [
                render function (_self)
                {
                      _this.actionRequiredPanel = this;
                }

              ]
              region = "north";
              tableName = "Crm_action";
              title = "Actions Required";
            },
            Roo.NestedLayoutPanel {
              Boolean background = false;
              Boolean fitContainer = true;
              Boolean fitToFrame = true;
              String region = "center";
              layout = Roo.BorderLayout {
                west = Roo.LayoutRegion {
                  Boolean hidden = true;
                  Boolean split = true;
                  Boolean titlebar = false;
                  Number width = 250;
                  String title = "Filter";
                }
                center = Roo.LayoutRegion {}
                [
                  Roo.NestedLayoutPanel {
                    String region = "west";
                    layout = Roo.BorderLayout {
                      center = Roo.LayoutRegion {
                        String tabPosition = "bottom";
                      }
                      [
                        Roo.ContentPanel {
                          Boolean autoScroll = true;
                          Boolean background = false;
                          Boolean fitContainer = true;
                          Boolean fitToFrame = true;
                          String title = "Advanced Search";
                          toolbar = Roo.Toolbar {
                            [
                              Roo.Toolbar.Fill {},
                              Roo.Toolbar.Button {
                                icon = rootURL + '/Pman/templates/images/search.gif';
                                cls = "x-btn-text-icon";
                                listeners [
                                  click function (_self, e)
                                  {
                                        _this.grid.footer.onClick('first');
                                  }

                                ]
                                text = "Search";
                              },
                              Roo.Toolbar.Button {
                                icon = rootURL + '/Pman/templates/images/edit-clear.gif';
                                cls = "x-btn-icon";
                                listeners [
                                  click function (_self, e)
                                  {
                                        _this.search_form.reset();
                                        
                                       // _this.form.findField('flegt').setRawValue('');
                                        
                                        _this.grid.footer.onClick('first');
                                  }

                                ]
                              }
                            ]
                          }
                          [
                            Roo.form.Form {
                              url = baseURL + '/Roo/crm_person.php';
                              hideLabels = true;
                              [
                                Roo.form.TextField {
                                  Number width = 225;
                                  String emptyText = "Search (company or name)";
                                  String name = "search_company";
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.searchBox = this;
                                    }
,
                                    specialkey function (_self, e)
                                    {
                                          if (e.getKey() == 13) {
                                              _this.grid.footer.onClick('first');
                                          }
                                    }

                                  ]
                                },
                                Roo.form.ComboBox {
                                  allowBlank = false;
                                  alwaysQuery = true;
                                  displayField = "name";
                                  editable = false;
                                  emptyText = "Select Contact";
                                  fieldLabel = "Person";
                                  forceSelection = true;
                                  hiddenName = "contact";
                                  store = Roo.data.Store {
                                    proxy = Roo.data.HttpProxy {
                                      url = baseURL + '/Roo/Crm_person.php';
                                      method = "GET";
                                    }
                                    reader = Roo.data.JsonReader {
                                      fields = [
    {
        "name":"key",
        "type":"string"
    },
    {
        "name":"name",
        "type":"string"
    }
]                                      id = "id";
                                      root = "data";
                                      totalProperty = "total";
                                    }
                                    listeners [
                                      load function (_self, records, options)
                                      {
                                           /*Roo.each( [
                                           {
                                                    'id' : 'my',
                                                    'name' : "My Contacts"
                                               },{
                                                    'id' : 'owner',
                                                    'name' : "Contacts with owners"
                                               },{
                                                    'id' : 'all',
                                                    'name' : "All Contacts"
                                               },{
                                                    'id' : 'email',
                                                    'name' : "Imported or user email"
                                               },{
                                                    'id' : 'company',
                                                    'name' : "Our company contacts"
                                               },{
                                                    'id' : 'not_active',
                                                    'name' : "Deleted Contacts"
                                                }
                                            ], function(r) {
                                                 var rr = this.reader.newRow( r); 
                                                 records.unshift(rr);
                                                 
                                            }, this);
                                            
                                           */
                                            Roo.log(records);
                                            this.each(function(r){
                                                if(!(r.data.active * 1)) {
                                                    r.set("style", "color:lightgrey!important;");
                                                } else  if (r.data.key * 1 > 0) {
                                                    r.set("style", "color:blue!important;");        
                                                }
                                            });
                                      }
,
                                      beforeload function (_self, o)
                                      {
                                            o.params = o.params || {};
                                            // set more here
                                            o.params['_distinct'] = 'owner_id';
                                            o.params['_columns'] = 'owner_id,owner_id_name,owner_id_active';
                                            o.params['_multisort'] = JSON.stringify({ 
                                                sort : { 'owner_id_active' : 'DESC', 'owner_id_name': 'ASC' }, 
                                                order : [ 'owner_id_active', 'owner_id_name' ]
                                            });
                                            o.params['_with_owner'] = 1;
                                      }

                                    ]
                                    remoteSort = true;
                                  }
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.contactBox = _self;
                                    }
,
                                    select function (combo, record, index)
                                    {
                                          _this.grid.footer.onClick('first');
                                    }

                                  ]
                                  loadingText = Searching...;
                                  minChars = 2;
                                  name = "contact";
                                  pageSize = 999;
                                  qtip = "Select Office";
                                  queryParam = "_title";
                                  selectOnFocus = true;
                                  tpl = '<div class="x-grid-cell-text x-btn button" style="{style}"><b>{name}</b></div>';
                                  triggerAction = "all";
                                  typeAhead = true;
                                  value = "All Contacts";
                                  valueField = "key";
                                  width = 225;
                                },
                                Roo.form.ComboBox {
                                  Number width = 225;
                                  allowBlank = false;
                                  displayField = "value";
                                  editable = false;
                                  store = Roo.data.SimpleStore {
                                    data = [
     [ 'all', "All" ],
     [ 'co', "Customer Only" ],
     [ 'leads', "Leads" ],
     [ 'not_cl', "Potential Clients" ],
     [ 'for_cold_call', "For Cold Call" ],
     [ 'active', "Active" ],
     [ 'have_met', "Have Met" ]
]                                    fields = [ 'key', 'value'];
                                  }
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.clientsCombo = _self;
                                    }
,
                                    select function (combo, record, index)
                                    {
                                          _this.grid.footer.onClick('first');
                                    }

                                  ]
                                  mode = "local";
                                  triggerAction = "all";
                                  value = "all";
                                  valueField = "key";
                                },
                                Roo.form.ComboBox {
                                  tpl = (function()
                                  {
                                        return 
                                            '<div class="x-grid-cell-text x-btn button" style="display:flex; align-items:center;">' +
                                            '<div style="display:inline-block; width:380px; font-weight:bold; white-space:normal;">{name}</div>' +
                                            '<div style="display:inline-block; width:150px; white-space:normal;">{comptype_id_display_name}</div>' +
                                            '<div style="display:inline-block; width:120px; font-style:italic; white-space:normal;" class="{contact_class}">{contact_display}</div>' +
                                            '<div style="display:inline-block; width:50px;">{last_contact_duration}</div>' +
                                            '</div>';
                                  }
                                  Number listWidth = 750;
                                  alwaysQuery = true;
                                  bool allowBlank = true;
                                  bool editable = true;
                                  displayField = "name";
                                  emptyText = "Search by Company";
                                  fieldLabel = "Company";
                                  forceSelection = true;
                                  hiddenName = "company_id";
                                  store = Roo.data.Store {
                                    sortInfo = { direction : 'ASC', field: 'name' };
                                    proxy = Roo.data.HttpProxy {
                                      url = baseURL + '/Roo/Core_company.php';
                                      method = "GET";
                                    }
                                    reader = Roo.data.JsonReader {
                                      fields = [
    {
        "name":"id",
        "type":"int"
    },
    {
        "name":"name",
        "type":"string"
    }
]                                      id = "id";
                                      root = "data";
                                      totalProperty = "total";
                                    }
                                    listeners [
                                      load function (_self, records, options)
                                      {
                                            Roo.each(records, function(record) {
                                                var owners = record.get('contact_owners');
                                                var no_active_contact = record.get('no_active_contact');
                                                
                                                record.set('contact_display', owners);
                                                record.set('contact_class', no_active_contact * 1 ? 'crm-red' : '');
                                                
                                                var lastContactDate = Date.parseDate(record.get('last_contact'), "Y-m-d H:i:s");
                                                if (!lastContactDate || lastContactDate < Date.parseDate("2000-01-01", "Y-m-d")) {
                                                    record.set('last_contact_duration', '');
                                                    return;
                                                }
                                                
                                                var diff = lastContactDate.getElapsed(new Date(), Date.DAY);
                                                var monthDiff = Math.floor(diff / 30);
                                                var yearDiff = Math.floor(diff / 365);
                                                
                                                var ret = diff + ' days';
                                                
                                                // >= 2 months
                                                if(monthDiff >= 2) {
                                                    ret = monthDiff + ' months';
                                                }
                                                // >= 1 year
                                                if(yearDiff >= 1) {
                                                    ret = yearDiff + ' year' + (yearDiff > 1 ? 's' : '');
                                                }
                                                
                                                record.set('last_contact_duration', ret);
                                            });
                                      }
,
                                      beforeload function (_self, o)
                                      {
                                            o.params = o.params || {};
                                            o.params._with_owners = 1;
                                            o.params._with_last_contact = 1;
                                      }

                                    ]
                                    remoteSort = true;
                                  }
