                          Roo.Toolbar.Fill {},
                          Roo.Toolbar.Button {
                            menu = Roo.menu.Menu {
                              [
                                Roo.menu.Item {
                                  String text = "Send Email to All Selected";
                                  listeners [
                                    click function (_self, e)
                                    {
                                          Roo.MessageBox.alert("Notice", "Coming Soon");
                                    }
,
                                    render function (_self)
                                    {
                                          _this.sendEmailToSelected = _self;
                                          _self.show();
                                          if(_this.grid.getSelectionModel().singleSelect) {
                                              _self.hide();
                                          }
                                    }

                                  ]
                                },
                                Roo.menu.Item {
                                  String text = "Bulk Update Details";
                                  listeners [
                                    click function (_self, e)
                                    {
                                          var s = _this.grid.getSelectionModel().getSelections();
                                          if (!s.length)  {
                                              Roo.MessageBox.alert("Error", "Select at least one Row");
                                              return;
                                          }
                                          
                                          var companyIds = [];
                                          var personIds = [];
                                          Roo.each(s, function(selection) {
                                              if(selection.data.company_id * 1 && !companyIds.includes(selection.data.company_id)) {
                                                  companyIds.push(selection.data.company_id);
                                              }
                                              personIds.push(selection.data.id);
                                          });
                                          
                                          Pman.Dialog.CrmBulkChange.show({
                                              _company_ids : companyIds,
                                              _person_ids: personIds
                                          }, function(res) {
                                              _this.grid.footer.onClick('first');
                                          }); 
                                    }
,
                                    render function (_self)
                                    {
                                          _this.bulkUpdateSelected = _self;
                                          _self.show();
                                          if(_this.grid.getSelectionModel().singleSelect) {
                                              _self.hide();
                                          }
                                    }

                                  ]
                                },
                                Roo.menu.Item {
                                  String text = "Bulk Update All Matched";
                                  listeners [
                                    click function (_self, e)
                                    {
                                          var params = _this.grid.buildParams({});
                                          delete params['_with_mailing_lists'];
                                          delete params['_with_comp_and_industry'];
                                          delete params['_with_last_contact'];
                                          delete params['join_service'];
                                          params['limit'] = 999999999;
                                          params['_columns'] = 'id,company_id';
                                          
                                          new Pman.Request({
                                              url : baseURL + '/Roo/Crm_person.php',
                                              method : 'GET',
                                              mask : 'Fetching matching contcts',
                                              params : params,
                                              success : function(res) {
                                                  if(res.total == 0) {
                                                      Roo.MessageBox.alert('Error', 'No matching contacts');
                                                      return;
                                                  }
                                                  
                                                  var companyIds = [];
                                                  var personIds = [];
                                                  Roo.each(res.data, function(c) {
                                                      if(c.company_id * 1 && !companyIds.includes(c.company_id)) {
                                                          companyIds.push(c.company_id);
                                                      }
                                                      personIds.push(c.id);
                                                  });
                                                  
                                                  Pman.Dialog.CrmBulkChange.show({
                                                      _company_ids : companyIds,
                                                      _person_ids: personIds
                                                  }, function(res) {
                                                      _this.grid.footer.onClick('first');
                                                  }); 
                                              }
                                          });
                                    }

                                  ]
                                },
                                Roo.menu.Item {
                                  hidden = (function()
                                  {
                                        return !Pman.hasPerm('Crm.ChangeOwner', 'S');
                                  }
                                  String text = "Change contact ownership by matching companies";
                                  listeners [
                                    click function (_self, e)
                                    {
                                          
                                          Pman.Dialog.CrmBulkChangeCompany.show({}, function(res) {
                                              _this.grid.footer.onClick('first');
                                          }); 
                                    }

                                  ]
                                },
                                Roo.menu.Item {
                                  listeners [
                                    click function (_self, e)
                                    {
                                          Roo.MessageBox.confirm("Confirm", "Are you sure you want to delete all matching contacts?", function(r) {
                                              if (r!='yes') {
                                                  return;
                                              }
                                              
                                              var batchDeleteStart = 0;
                                              var batchDeleteLimit = 25;
                                              var ids = [];
                                              var total = 0;
                                              
                                              var deleteBatch = function() {
                                                      new Pman.Request({
                                                          url : baseURL + '/Roo/Crm_person',
                                                          method : 'POST',
                                                          params : {
                                                              active : 0,
                                                              _delete_ids : ids.slice(batchDeleteStart, batchDeleteStart + batchDeleteLimit).join(',')
                                                          },
                                                          success : function(res){
                                                              batchDeleteStart += batchDeleteLimit;
                                                              Roo.MessageBox.updateProgress(batchDeleteStart / total,
                                                              batchDeleteStart + " / " + total + " contacts deleted");
                                                              if(batchDeleteStart >= total) {
                                                                  Roo.MessageBox.hide();
                                                                  _this.grid.footer.onClick('first');
                                                                  return;
                                                              }
                                                              deleteBatch();
                                                          }
                                                      });
                                              };
                                              
                                              var params = _this.grid.buildParams({});
                                              delete params['_with_mailing_lists'];
                                              delete params['_with_comp_and_industry'];
                                              delete params['_with_last_contact'];
                                              delete params['join_service'];
                                              params['limit'] = 999999999;
                                              params['_columns'] = 'id';
                                              
                                              if(!['email_failure', 'bad_domain'].includes(params._email_filter)) {
                                                  Roo.MessageBox.alert('Error', 'Please select invalid email filter before deleting all matches');
                                                  return;
                                              }
                                                  
                                              new Pman.Request({
                                                  url : baseURL + '/Roo/Crm_person.php',
                                                  method : 'GET',
                                                  mask : 'Fetching matching contcts',
                                                  params : params,
                                                  success : function(res) {
                                                      Roo.each(res.data, function(c) {
                                                          ids.push(c.id);
                                                      });
                                                      
                                                      total = res.total;
                                                      
                                                      if(total == 0) {
                                                          Roo.MessageBox.alert('Error', 'No matching invalid contacts');
                                                          return;
                                                      }
                                                      
                                                      deleteBatch();
                                                  }
                                              });
                                          });
                                    }
,
                                    render function (_self)
                                    {
                                          _this.deleteAllMatch = _self;
                                          // hidden by default
                                          _self.hide();
                                          // shown only when invalid filter is applied
                                          if(['email_failure', 'bad_domain'].includes(_this.emailValidityCombo.getValue())) {
                                              _self.show();
                                          }
                                    }

                                  ]
                                  text = "Delete All Matches";
                                },
                                Roo.menu.Item {
                                  String text = "Add Selected To Mailing List";
                                  listeners [
                                    click function (_self, e)
                                    {
                                          var s = _this.grid.getSelectionModel().getSelections();
                                                                   
                                          if(!s.length) {
                                              Roo.MessageBox.alert('Error', 'Please select at least one contact');
                                              return;
                                          }
                                      
                                          var contactIds = [];
                                          Roo.each(s, function(selection) {
                                              contactIds.push(selection.data.id);
                                          });
                                      
                                      
                                          Pman.Dialog.CrmMailingListSelect.show({
                                                  _person_ids: contactIds
                                              }, function(res) {
                                              _this.grid.footer.onClick('first');
                                          });
                                    }
,
                                    render function (_self)
                                    {
                                          _this.addSelectedToMailingList = _self;
                                          _self.show();
                                          if(_this.grid.getSelectionModel().singleSelect) {
                                              _self.hide();
                                          }
                                    }

                                  ]
                                },
                                Roo.menu.Item {
                                  String text = "Add All Matches to Mailing List";
                                  listeners [
                                    click function (_self, e)
                                    {
                                          var params = _this.grid.buildParams({});
                                          delete params['_with_mailing_lists'];
                                          delete params['_with_comp_and_industry'];
                                          delete params['_with_last_contact'];
                                          delete params['join_service'];
                                          params['limit'] = 999999999;
                                          params['_columns'] = 'id';
                                              
                                          new Pman.Request({
                                              url : baseURL + '/Roo/Crm_person.php',
                                              method : 'GET',
                                              mask : 'Fetching matching contcts',
                                              params : params,
                                              success : function(res) {
                                                  var contactIds = [];
                                                  Roo.each(res.data, function(c) {
                                                      contactIds.push(c.id);
                                                  });
                                                  
                                                  if(res.total == 0) {
                                                      Roo.MessageBox.alert('Error', 'No matching contacts');
                                                      return;
                                                  }
                                                  
                                                  Pman.Dialog.CrmMailingListSelect.show({
                                                          _person_ids: contactIds
                                                      }, function(res) {
                                                      _this.grid.footer.onClick('first');
                                                  });
                                              }
                                          });
                                    }

                                  ]
                                }
                              ]
                            }
                            listeners [
                              render function (_self)
                              {
                                    _this.bulkChangeMenu = _self;
                              }

                            ]
                            text = "Bulk Change";
                          },
                          Roo.Toolbar.Button {
                            icon = Roo.rootURL + 'images/default/tree/leaf.gif';
                            cls = "x-btn-text-icon";
                            listeners [
                              click function()
                              {
                                    if (!_this.dialog)  { 
                                        return; 
                                    }
                                    var s = _this.grid.getSelectionModel().getSelections();
                                    if (!s.length || (s.length > 1))  {
                                        Roo.MessageBox.alert("Error", s.length ? "Select only one Row" : "Select a Row");
                                        return;
                                    }
                                    
                                    if(s[0].data.id * 1 < 0) {
                                        Roo.MessageBox.alert("Error", "You cannot edit contact to which you have no access");
                                        return;
                                    }
                                    
                                    _this.dialog.show( {id : s[0].data.id}, function() {
                                        _this.grid.footer.onClick('first');
                                   }); 
                              }

                            ]
                            text = "Edit";
                          },
                          Roo.Toolbar.Button {
                            icon = Roo.rootURL + 'images/default/dd/drop-add.gif';
                            cls = "x-btn-text-icon";
                            listeners [
                              click function()
                              {
                                    if (!_this.dialog)  { 
                                        return; 
                                    }
                                    _this.dialog.show( { _id : 0 , staff_id : Pman.Login.authUser.id} , function() {
                                        _this.grid.footer.onClick('first');
                                   }); 
                              }

                            ]
                            text = "Add";
                          },
                          Roo.Toolbar.Button {
                            icon = Roo.rootURL + 'images/default/dd/drop-add.gif';
                            cls = "x-btn-text-icon";
                            listeners [
                              click function()
                              {
                                    var s = _this.grid.getSelectionModel().getSelections();
                                    if (!s.length || (s.length > 1))  {
                                        Roo.MessageBox.alert("Error", s.length ? "Select only one Row" : "Select a Row");
                                        return;
                                    }
                                    
                                    if(s[0].data.id * 1 < 0) {
                                        Roo.MessageBox.alert("Error", "You cannot duplicate contact to which you have no access");
                                        return;
                                    }
                                    
                                    Pman.Dialog.CrmPerson.show({
                                        company_id : s[0].data.company_id,
                                        office_id : s[0].data.office_id
                                    }, function(){
                                        _this.grid.footer.onClick('first');
                                    });
                              }

                            ]
                            text = "Duplicate";
                          },
                          Roo.Toolbar.Button {
                            icon = rootURL + '/Pman/templates/images/trash.gif';
                            Boolean hidden = true;
                            cls = "x-btn-text-icon";
                            listeners [
                              render function (_self)
                              {
                                    _this.deleteBtn = _self;
                              }
,
                              click function()
                              {
                                    var s = _this.grid.getSelectionModel().getSelections();
                                    if (!s.length)  {
                                        Roo.MessageBox.alert("Error", "Select at least one Row");
                                        return;
                                    }
                                    
                                    var canDelete = true;
                                    
                                    var ids = [];
                                    var active = 0;
                                    Roo.each(s, function(selection) {
                                        // contacts that the user doesn't have access to
                                        if(selection.id * 1 < 0) {
                                            canDelete = false;
                                        }
                                        ids.push(selection.id);
                                        active = selection.data.active * 1 ? 0 : 1;
                                    });
                                    
                                    if(!canDelete) {
                                        Roo.MessageBox.alert("Error", "You cannot delete / undelete contacts to which you have no access");
                                        return;
                                    }
                                    
                                    Roo.MessageBox.confirm("Confirm", "Are you sure you want to " +
                                        (active * 1 ? "un-delete" : "delete") +" these contacts?", function(r) {
                                        if (r!='yes') {
                                            return;
                                        }
                                        
                                        
                                        new Pman.Request({
                                            url : baseURL + '/Roo/Crm_person',
                                            method : 'POST',
                                            params : {
                                                active : active,
                                                _delete_ids : ids.join(',')
                                            },
                                            success : function(res){
                                                _this.grid.footer.onClick('first');
                                                 
                                            },
                                            failure : function(e){
                                                Roo.MessageBox.alert("Error", "Fetching the updated record failed, refreshing list");
                                            
                                                _this.grid.footer.onClick('first');
                                            }
                                        });
                                    });
                                    
                                    return;
                              }

                            ]
                            text = "Delete";
                          }
                        ]
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v, x, r) 
                        {
                              if(v){
                                  var v = new Date(v);
                                  var dt = new Date();
                                  if(v < dt) { // passed
                                      return  String.format('<span style="color:grey">{0}</span>', v.format('d/M/Y')); 
                                  }
                                  // future
                                  return  String.format('<span style="color:red">{0}</span>', v.format('d/M/Y')); 
                              } 
                              return String.format('{0}', ''); 
                              
                        }
                        dataIndex = "crm_contact_again_notify_id_act_start";
                        header = "Contact Again";
                        sortable = true;
                        width = 75;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                              var vv = typeof(v) == "string" ?  Date.parseDate(v, "Y-m-d H:i:s") : v;
                              if (!vv || vv < Date.parseDate("2000-01-01", "Y-m-d")) {
                                  return '';
                              }
                          
                              var diff = vv.getElapsed(new Date(), Date.DAY);
                              var monthDiff = Math.floor(diff / 30);
                              var yearDiff = Math.floor(diff / 365);
                              
                              var ret = diff + ' days';
                              
                              // >= 2 months
                              if(monthDiff >= 2) {
                                  ret = monthDiff + ' months';
                              }
                              // >= 1 year
                              if(yearDiff >= 1) {
                                  ret = yearDiff + ' year' + (yearDiff > 1 ? 's' : '');
                              }
                              
                              return "<span qtip='" + vv.format('d/M/Y') + "'>" + ret + "</span>";
                        }
                        Boolean sortable = true;
                        dataIndex = "last_contact";
                        header = "Last Contact";
                        width = 80;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                              // deleted: light grey + strike through
                              if(!r.data.active) {
                                  return String.format("<s style='color:lightgrey;'>{0}</s>", v);
                              }
                              
                              var failed = r.data.email_fails * 1 >= 6;
                              var hasMx = 1;
                              
                              var mxUpdated = r.data.domain_id_mx_updated instanceof Date ?
                                  r.data.domain_id_mx_updated.format('Y-m-d H:i:s') :
                                  r.data.domain_id_mx_updated;
                              
                              if(
                                  r.data.domain_id_id * 1 &&
                                  mxUpdated != '1000-01-01 00:00:00' && 
                                  !(r.data.domain_id_has_mx * 1)
                              ) {
                                  hasMx = 0;
                              }
                              
                              // good email
                              if(!failed && hasMx) {
                                  return String.format(
                                      "<span class='crm-blue-link' qtip='{0}'>{1}</span>", 
                                      r.data.email, 
                                      v
                                  );
                              }
                              
                              var reason = !hasMx ? 'Invalid domain' : 'Too many failures';
                              
                              // failed / no mx
                              return String.format( 
                                  "<span style='color:lightgrey;' qtip='{0}<br>{1}'>{2}</span>",
                                  r.data.email,
                                  reason,
                                  v
                              );
                        }
                        dataIndex = "name";
                        header = "Name";
                        sortable = true;
                        width = 120;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v, x, r) 
                        {
                              // users can view email / phone and owner of contacts they don't have access to
                              // when they search by email / phone
                              // but cannot view/edit anything else
                              if(r.data.id * 1 < 0) {
                                  return '';
                              }
                              var ret = [];
                              Roo.each(v, function(ml) {
                                  var prefix = '';
                                  if(ml.type == 'FILTER') {
                                      prefix = '<span style="background-color:blue; color:white;">[G]</span>';
                                  }
                                  ret.push(prefix + String.format('{0}', ml.name));
                              });
                              return ret.join('<br/>');
                        }
                        dataIndex = "mailing_lists";
                        header = "Mailing Lists";
                        sortable = true;
                        width = 150;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v, x, r) 
                        {
                              var style = "style='color:#666'";
                              var strikethrough = 0;
                              
                              // Deleted : light grey + strike through
                              if(!(r.data.active * 1)) {
                                  style = "style='color:lightgrey;'";
                                  strikethrough = 1;
                              }
                              
                              return String.format( 
                                  strikethrough ?  
                                  '<s ' + style + '>{0}</s>' :
                                  '<span ' + style + '>{0}</span>' , 
                                  v
                              );
                              
                        }
                        Boolean hidden = true;
                        dataIndex = "role";
                        header = "Job Title";
                        sortable = true;
                        width = 150;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                              var s = '';
                              if(typeof(r.data.is_customer_list) != 'undefined' && r.data.is_customer_list.length > 0){
                                  s = 'color: green;';
                              }
                              
                              return String.format('<span style="'+s+'">{0}</span>', v);
                        }
                        dataIndex = "company_id_name";
                        header = "Company";
                        sortable = true;
                        width = 100;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v, x, r)
                        {
                              var services = r.data.services; 
                              if(!services.length) {
                                  return "<span class='crm-blue-link'>none</span>";
                              }
                              
                              var ret = [];
                              
                              Roo.each(services, service => {
                                  var row = String.format('{0}', service.crm_service_id_display_name);
                                  var startedDt = service.started_dt === '1000-01-01 00:00:00' ? new Date('invalid') : new Date(service.started_dt);
                                  var expiresDt = service.expires_dt === '1000-01-01 00:00:00' ? new Date('invalid') : new Date(service.expires_dt);
                                  var closingDt = service.est_closing === '1000-01-01 00:00:00' ? new Date('invalid') : new Date(service.est_closing);
                                  var now = new Date();
                                  var expired = !isNaN(expiresDt) && expiresDt.getTime() < now.getTime();
                                  var closed = !isNaN(closingDt) && closingDt.getTime() < now.getTime();
                                  
                                  if(service.is_interested * 1) {
                                      ret.push(String.format(
                                          "<span "
                                          + "style='cursor:pointer;' "
                                          + "class='" + (closed ? 'crm-red-tag' : 'crm-orange-tag') + "'"
                                          + "qtip='Is Interested"
                                          + (service.probability * 1 ? " | Probability: {0}%" : "")
                                          + (service.est_value * 1 ? " | Est.Budget: \${1}" : "")
                                          + (!isNaN(closingDt) ? " | Est. Closing: {2}" : "")
                                          + "'"
                                          + ">[In]</span> <span style='cursor:pointer;'>{3}</span>" ,
                                          service.probability,
                                          service.est_value,
                                          closingDt.format('Y-m-d'),
                                          service.crm_service_id_display_name
                                      ));
                                  }
                                  
                                  if(service.is_customer * 1) {
                                      ret.push(String.format(
                                          "<span "
                                          + "style='cursor:pointer;' "
                                          + "class='" + (expired ? 'crm-red-tag' : 'crm-green-tag') + "'"
                                          + "qtip='Is Customer"
                                          + (!isNaN(startedDt) ? " since {0}" : "")
                                          + (!isNaN(expiresDt) ? " expires {1}" : "")
                                          + (service.last_year_sales * 1 ? " | Total Sales: \${2}" : "")
                                          + "'>[C]</span> <span style='cursor:pointer;'>{3}</span>",
                                          startedDt.format('Y-m-d'),
                                          expiresDt.format('Y-m-d'),
                                          service.last_year_sales,
                                          service.crm_service_id_display_name
                                      ));
                                  }
                              });
                              
                              return ret.join("<br/>");
                        }
                        Boolean sortable = true;
                        dataIndex = "services";
                        header = "Service Status";
                        width = 125;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                              // email with fails
                              var emailCls = 'crm-red crm-strikethrough';
                              
                              // good email
                              if(r.data.email_fails * 1 < 6) {
                                  emailCls = 'crm-green';
                                  // unsubscribed
                                  if(r.data.crm_is_unsubscribed * 1) {
                                      emailCls = 'crm-gray crm-strikethrough';
                                  }
                              }
                              var cls = 'class="' + emailCls + '"';
                              
                              return String.format( 
                                  r.data.email_fails * 1 >= 6 ? 
                                  '<span ' + cls + '>{0}</span>' :
                                  '<a href="mailto:{0}" ' + cls + '>{0}</a>' , 
                                  v
                              );
                        }
                        Boolean hidden = true;
                        dataIndex = "email";
                        header = "Email";
                        width = 120;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                              return String.format('{0}', v * 1 > 0 ? 'Invalid' : 'Valid');
                        }
                        Boolean hidden = true;
                        Boolean sortable = true;
                        dataIndex = "email_fails";
                        header = "Valid";
                        width = 70;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', Pman.I18n.toName('c', v)); 
                        }
                        dataIndex = "office_id_country";
                        header = "Country";
                        width = 50;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r) 
                        {
                              if(!(r.data.owner_id * 1)){
                                  return '';
                              }
                              // users can view email / phone and owner of contacts they don't have access to
                              // when they search by email / phone
                              // but cannot view/edit anything else
                              if(r.data.id * 1 < 0) {
                                  if(!r.data.owner_id_active * 1) {
                                      if(Pman.hasPerm('Crm.Can_Own_Contacts', 'S')) {
                                          return String.format("<b><s>{0}</s></b><br><span class='crm-blue-link'>Request Ownership</span>", v);
                                      }
                                      return String.format("<b><s>{0}</s></b>", v);
                                  }
                                  if(Pman.hasPerm('Crm.Can_Own_Contacts', 'S')) {
                                      return String.format("<b>{0}</b><br><span class='crm-blue-link'>Request Ownership</span>", v);
                                  }
                                  return String.format('<b>{0}</b>', v); 
                              }
                              // old staff: light grey + strike through
                              if(!r.data.owner_id_active * 1) {
                                  return String.format("<s style='color:lightgrey;'>{0}</s>", v);
                              }
                              
                              return String.format('{0}', v); 
                        }
                        dataIndex = "owner_id_name";
                        header = "Owner";
                        width = 120;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v)
                        {
                              var state = v> 0 ?  '' : '-checked';
                          
                              return '<img class="x-grid-check-icon' + state + '" src="' + Roo.BLANK_IMAGE_URL + '"/>';
                        }
                        Boolean hidden = true;
                        dataIndex = "crm_is_unsubscribed";
                        header = Subs.;
                        width = 50;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean hidden = true;
                        Boolean sortable = true;
                        dataIndex = "phone";
                        header = "Phone";
                        width = 80;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean hidden = true;
                        Boolean sortable = true;
                        dataIndex = "phone_direct";
                        header = "Phone (Direct)";
                        width = 80;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean hidden = true;
                        Boolean sortable = true;
                        dataIndex = "phone_mobile";
                        header = "Phone (Mobile)";
                        width = 80;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean hidden = true;
                        Boolean sortable = true;
                        dataIndex = "office_id_phone";
                        header = "Phone (Office)";
                        width = 80;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean sortable = true;
                        dataIndex = "company_id_comptype_id_display_name";
                        header = "Company Type";
                        width = 80;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean sortable = true;
                        dataIndex = "company_id_crm_industry_id_display_name";
                        header = "Client Industry";
                        width = 80;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean sortable = true;
                        dataIndex = "crm_business_focus_names";
                        header = "Business Focus";
                        width = 85;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                          
                                 return String.format('{0}', v); 
                        }
                        Boolean sortable = true;
                        dataIndex = "crm_client_of_competitor_names";
                        header = "Client Of Competitor";
                        width = 105;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                              var vv = typeof(v) == "string" ?  Date.parseDate(v, "Y-m-d H:i:s") : v;
                              if (!vv || vv < Date.parseDate("2000-01-01", "Y-m-d")) {
                                  return '<i>never opened</i>';
                              }
                          
                              var diff = vv.getElapsed(new Date(), Date.DAY);
                              var monthDiff = Math.floor(diff / 30);
                              var yearDiff = Math.floor(diff / 365);
                              
                              var ret = diff + ' days';
                              
                              // >= 2 months
                              if(monthDiff >= 2) {
                                  ret = monthDiff + ' months';
                              }
                              // >= 1 year
                              if(yearDiff >= 1) {
                                  ret = yearDiff + ' year' + (yearDiff > 1 ? 's' : '');
                              }
                              
                              return "<span qtip='" + vv.format('d/M/Y') + "'>" + ret + "</span>";
                        }
                        Boolean sortable = true;
                        dataIndex = "last_opened";
                        header = "Last Opened";
                        width = 80;
                      }
                      listeners [
                        cellclick function (_self, rowIndex, columnIndex, e)
                        {
                              var di = this.colModel.getDataIndex(columnIndex);
                              var rec = _this.grid.ds.getAt(rowIndex);
                              
                              // users can view email / phone and owner of contacts they don't have access to
                              // when they search by email / phone
                              // but cannot view/edit anything else
                              if(rec.data.id * 1 < 0) {
                                  // 'Request Ownership'
                                  if(di == 'owner_id_name') {
                                      if(e.getTarget().tagName.toLowerCase() != 'span') {
                                          return;
                                      }
                                      Roo.MessageBox.confirm("Confirm", "Do you want to request the ownership of this contact?", function(r) {
                                          if (r != 'yes') {
                                              return;
                                          }
                                          
                                          new Pman.Request({
                                              url : baseURL + '/Roo/Crm_person',
                                              method : 'POST',
                                              params : {
                                                  'id': rec.json.real_id,
                                                  '_request_ownership': 1
                                              },
                                              success : function(res){
                                                  Roo.MessageBox.alert("Requested", "Requested the ownership of this contact");
                                              }
                                          });
                                      });
                                  }
                                  return;
                              }
                              
                              switch(di){
                                  case 'crm_is_unsubscribed':
                                      rec.set(di, rec.data[di] ? 0 : 1); 
                                      rec.commit();
                                      return;
                                  case 'services':
                                      if(e.getTarget().tagName.toLowerCase() != 'span') {
                                          return;
                                      }
                                      
                                      
                                      Pman.Dialog.CrmAction.show({
                                          person_id: rec.data.id,
                                          action_type_id_name: 'NOTE', 
                                          company_id: rec.data.company_id,
                                          owner_id: rec.data.owner_id,
                                          owner_id_active: rec.data.owner_id_active,
                                          owner_id_name: rec.data.owner_id_name
                                      } , function() {
                                          _this.actionRequiredGrid.footer.onClick('first');
                                          _this.grid.footer.onClick('refresh');
                                      });
                                      return;
                                  case 'name':
                                      // click the underlined link
                                      if(e.getTarget().tagName.toLowerCase() == 'span') {
                                          if(rec.data.email_fails * 1 >= 6) {
                                              break;
                                          }
                                          var mxUpdated = rec.data.domain_id_mx_updated instanceof Date ?
                                              rec.data.domain_id_mx_updated.format('Y-m-d H:i:s') :
                                              rec.data.domain_id_mx_updated;
                                          if(
                                              rec.data.domain_id_id * 1 &&
                                              mxUpdated != '1000-01-01 00:00:00' && 
                                              !(rec.data.domain_id_has_mx * 1)
                                          ) {
                                              break;
                                          }
                                          
                                          Pman.Dialog.MailCreateB.show( 
                                              { 
                                                  to: [{
                                                      id: rec.data.id,
                                                      name: rec.data.name,
                                                      email: rec.data.email,
                                                      tbl: 'crm_person'
                                                  }],
                                                  _focus_subject: 1
                                              }
                                          );
                                          return;
                                      }
                                      break;
                              }
                              
                              var s = _this.grid.getSelectionModel().getSelections();
                              
                              var eastRegion = _this.layout.getRegion('east');
                              
                              // no person is selected
                              // OR
                              // more than one person is selected
                              if(!s.length || s.length > 1) {
                                  // slide in if person region slided out
                                  if(eastRegion.isSlid) {
                                      eastRegion.slideIn();
                                  }
                                  // collapse if expanded
                                  if(!eastRegion.collapsed) {
                                      eastRegion.collapse();
                                  }
                                  return;
                              }
                              
                              // only one person is selected
                              
                              var rec = _self.sm.getSelected();
                              
                              // select the same perosn again
                              if(typeof(_this.viewPerson) != 'undefined' && _this.viewPerson.id == rec.id) {
                                  // slide in if person region slided out
                                  if(eastRegion.isSlid) {
                                      eastRegion.slideIn();
                                      return;
                                  }
                                  // collapse if expanded
                                  if(!eastRegion.collapsed) {
                                      eastRegion.collapse();
                                      return;
                                  }
                              }
                              
                              _this.viewPerson = rec.data;
                              
                              // DON't slide out if the person region is already expanded
                              if(eastRegion.collapsed) {
                                  eastRegion.show();
                                  eastRegion.slideOut();
                              }
                              
                              // load new person
                              eastRegion.titleTextEl.innerHTML = String.format('{0}',
                                  (rec.data.honor.length ? rec.data.honor + '. ' : '') + rec.data.name
                              );
                              _this.viewPersonGrid.ds.load();
                              
                              _this.viewPersonDeleteBtn.setText(rec.data.active ? 'Delete' : 'Un-delete');
                              var deleted = !(rec.data.active * 1);
                              var superseded = (rec.data.superseded_by_id * 1) > 0;
                              _this.viewPersonEditBtn.show();
                              _this.viewPersonAddActivityBtn.show();
                              _this.viewPersonUpdateServiceBtn.show();
                              _this.viewPersonDeleteBtn.show();
                              if (deleted) {
                                  _this.viewPersonEditBtn.hide();
                                  _this.viewPersonAddActivityBtn.hide();
                                  _this.viewPersonUpdateServiceBtn.hide();
                              }
                              if (superseded && deleted) {
                                  _this.viewPersonDeleteBtn.hide();
                              }
                        }
,
                        rowclick function (_self, rowIndex, e)
                        {
                              
                              var s = _this.grid.getSelectionModel().getSelections();
                              
                              // no person is selected
                              if(!s.length) {
                                  return;
                              }
                              
                              // some persons are selected
                              var actives = s.map(function(selection) { 
                                  return  selection.data.active * 1;
                              });
                              var uniqueActives = actives.filter(function(value, index, array) {
                                  return array.indexOf(value) === index;
                              });
                              
                              _this.deleteBtn.hide();
                              
                              // all selected persons are either active / deleted
                              if(uniqueActives.length == 1) {
                                  var undeleting = !(actives[0] * 1);
                                  var anySuperseded = s.some(function(sel) {
                                      return (sel.data.superseded_by_id * 1) > 0;
                                  });
                                  if (undeleting && anySuperseded) {
                                      return;
                                  }
                                  _this.deleteBtn.show();
                                  // show delete when selecting active persons
                                  // show un-delete when selecting deleted persons
                                  _this.deleteBtn.setText(actives[0] ? 'Delete' : 'Un-delete');
                              }
                        }
,
                        render function() 
                        {
                              _this.grid = this; 
                              _this.dialog = Pman.Dialog.CrmPerson;
                              if (_this.panel.active) {
                                 this.footer.onClick('first');
                              }
                              
                        }
,
                        rowdblclick function (_self, rowIndex, e)
                        {
                              if (!_this.dialog) { 
                                  return;
                              }
                          
                              var record = this.getDataSource().getAt(rowIndex);
                              
                              // users can view email / phone and owner of contacts they don't have access to
                              // when they search by email / phone
                              // but cannot view/edit anything else
                              if(record.data.id * 1 < 0) {
                                  return;
                              }
                              
                              setTimeout(() => _this.layout.getRegion('east').slideIn(), 1000);
                              
                              _this.dialog.show( {id : record.data.id}, function(res) {
                                  new Pman.Request({
                                      url : baseURL + '/Roo/Crm_person',
                                      method : 'GET',
                                      params : {
                                          _id : res.id,
                                          _with_comp_and_industry : 1
                                      },
                                      success : function(res) {
                                          if(res.success){
                                              for(var k in res.data) {
                                                  record.set(k, res.data[k]);
                                              }
                                              _this.actionRequiredGrid.ds.load();
                                          }
                                      },
                                      failure : function(e) {
                                          Roo.MessageBox.alert("Error", "Fetching the updated record failed, refreshing list");
                                          _this.grid.ds.load({});
                                      }
                                  });
                                  
                              }); 
                        }

                      ]
                      loadMask = true;
                      methods [
                        buildParams function(params)
                        {
                              params = params || {};
                              params._with_mailing_lists = 1;
                              params._with_comp_and_industry = 1;
                              params._has_future = 1;
                              
                              // Show / Hide Deleted
                              params['_hide_deleted'] = _this.deletedToggle.pressed ? 0 : 1;   
                              
                              // Add last contact
                              params._with_last_contact = 1;
                              
                              // Add services
                              params.join_service = 1;
                              
                              // Search
                              // use value from top search box if the search panel is hidden
                              // else use value from search box in the search panel 
                              params['query[search]'] = 
                                  _this.topSearchBox.isVisible() ? 
                                  _this.topSearchBox.getValue() :
                                  _this.searchBox.getValue();
                                  
                              // 'valid' by default
                              params._email_filter = 'valid';
                              
                              // filter panel is hidden
                              if(!_this.filterPanel.region.visible) {
                                  return params;
                              }
                              
                              // company panel is active
                              if(_this.companyPanel.active) {
                                  var selection = _this.companyGrid.getSelectionModel().getSelected();
                                  
                                  // a company is selected
                                  if(typeof(selection) !== 'undefined') {
                                      params.company_id = selection.data.id;
                                  }
                                  
                                  return params;
                              }
                              
                              // advanced search panel is active
                              
                              // Type of Contacts
                              params.filter = (_this.contactBox.getValue() == 'All Contacts') ? 'all': _this.contactBox.getValue();
                              
                              // Search by Releationship
                              params.clients = _this.clientsCombo.getValue();
                              
                              // Search by Company
                              var company_id = _this.companySel.getValue() * 1;
                              if(company_id > 0){
                                  params.company_id = company_id;
                              }
                              
                              // Search by Country
                              params.office_countries = _this.countrySel.getValue();
                              
                              // Search by Mailing List
                              if(_this.mailingListBox.getValue()){
                                  params['_mailing_list_id'] = _this.mailingListBox.getValue();
                                  if(_this.mailingListCheckbox.checked) {
                                      params['_mailing_list_id_only'] = 1;
                                  }
                              }
                              
                              // Search by Source
                              var crm_source_id = _this.sourceSel.getValue() * 1;
                              if(crm_source_id > 0){
                                  params.crm_source_id = crm_source_id;
                              }
                              
                              // Search by Job Title
                              params.roles = _this.roleSel.getValue();
                              
                              // Search by Company Type
                              params.comptypes = _this.companyTypeSel.getValue();
                              
                              // Search by Industry
                              var industry_id = _this.industrySel.getValue() * 1;
                              if(industry_id > 0){
                                  params.company_id_crm_industry_id = industry_id;
                              }
                              
                              // Search by Services Interested in
                              var interested_id = _this.interestedSel.getValue() * 1;
                              if(interested_id > 0){
                                  params._interested_in = interested_id;
                              }
                              
                              // Search by Business Focus
                              var crm_business_focus = _this.businessFocusSel.getValue() * 1;
                              if(crm_business_focus > 0){
                                  params._business_focus = crm_business_focus;
                              }
                              
                              // Search by Client of Competitor
                              var crm_client_of_competitor = _this.clientOfCompetitorSel.getValue() * 1;
                              if(crm_client_of_competitor > 0){
                                  params._client_of_competitor = crm_client_of_competitor;
                              }
                              
                              // Search by Which EDM they have opened
                              if(_this.mailingListMessageBox.getValue()) {
                                  params['_has_opened_mailing_list_message_id'] = _this.mailingListMessageBox.getValue();
                              }
                              
                              // Search by Last Activity
                              var dateType = _this.dateType.getValue();
                              var dateFrom = _this.dateFrom.getValue();
                              var dateTo = _this.dateTo.getValue();
                              if(dateType) {
                                  params._date_type = dateType;
                                  if(dateFrom) {
                                      params._date_from = dateFrom;
                                  }
                                  if(dateTo) {
                                      params._date_to = dateTo;
                                  }
                              }
                              
                              // Search by Email Validity
                              params._email_filter = _this.emailValidityCombo.getValue();
                              
                              return params;
                        }

                      ]
                    }
                    listeners [
                      activate function()
                      {
                            _this.panel = this;
                            if (_this.grid) {
                                //_this.grid.footer.onClick('first');
                            }
                      }

                    ]
                    region = "center";
                    tableName = "Person";
                    title = "Person";
                  }
                ]
              }
            }
          ]
        }
        listeners [
          activate function (_self)
          {
                _this.mainPanel = _self;
          }

        ]
        region = "center";
      },
      Roo.NestedLayoutPanel {
        background = true;
        fitContainer = true;
        fitToFrame = true;
        layout = Roo.BorderLayout {
          center = Roo.LayoutRegion {}
          south = Roo.LayoutRegion {
            Boolean split = true;
            Number height = 600;
          }
          [
            Roo.NestedLayoutPanel {
              background = true;
              fitContainer = true;
              fitToFrame = true;
              layout = Roo.BorderLayout {
                center = Roo.LayoutRegion {
                  String tabPosition = "top";
                }
                [
                  Roo.panel.Grid {
                    Boolean background = false;
                    fitContainer = true;
                    fitToframe = true;
                    grid = Roo.grid.Grid {
                      String autoExpandColumn = "value";
                      toolbar = Roo.Toolbar {
                        [
                          Roo.Button {
                            icon = Roo.rootURL + 'images/default/tree/leaf.gif';
                            cls = "x-btn-text-icon";
                            listeners [
                              render function (_self)
                              {
                                    _this.viewPersonEditBtn = _self;
                              }
,
                              click function()
                              {
                                    if(!_this.viewPerson) {
                                        return false;
                                    }
                                    if (!(_this.viewPerson.active * 1)) {
                                        Roo.MessageBox.alert('Error', "This contact is deleted. Un-delete it before editing.");
                                        return false;
                                    }
                                    
                                    _this.dialog.show( {id : _this.viewPerson.id}, function(res) {
                                        new Pman.Request({
                                            url : baseURL + '/Roo/Crm_person',
                                            method : 'GET',
                                            params : {
                                                _id : res.id,
                                                _with_comp_and_industry : 1
                                            },
                                            success : function(res) {
                                                if(res.success){
                                                    _this.grid.ds.load();
                                                    _this.viewPersonGrid.ds.load();
                                                }
                                            },
                                            failure : function(e) {
                                                Roo.MessageBox.alert("Error", "Fetching the updated record failed, refreshing list");
                                                _this.grid.ds.load({});
                                            }
                                        });
                                        
                                    });
                              }

                            ]
                            text = "Edit Person";
                          },
                          Roo.Toolbar.Fill {},
                          Roo.Toolbar.Button {
                            icon = Roo.rootURL + 'images/default/dd/drop-add.gif';
                            cls = "x-btn-text-icon";
                            listeners [
                              click function()
                              {
                                    if(!_this.viewPerson) {
                                        return false;
                                    }
                                    
                                    Pman.Dialog.CrmPerson.show({
                                        company_id : _this.viewPerson.company_id,
                                        office_id : _this.viewPerson.office_id
                                    }, function(){
                                        _this.grid.footer.onClick('first');
                                    });
                              }

                            ]
                            text = "Duplicate";
                          },
                          Roo.Toolbar.Button {
                            icon = rootURL + '/Pman/templates/images/trash.gif';
                            cls = "x-btn-text-icon";
                            listeners [
                              render function (_self)
                              {
                                    _this.viewPersonDeleteBtn = _self;
                              }
,
                              click function()
                              {
                                    if(!_this.viewPerson) {
                                        return false;
                                    }
                                    
                                    var active = _this.viewPerson.active * 1 ? 0 : 1;
                                    if (active * 1 && (_this.viewPerson.superseded_by_id * 1) > 0) {
                                        Roo.MessageBox.alert('Error', "Cannot un-delete a superseded contact");
                                        return false;
                                    }
                                    
                                    Roo.MessageBox.confirm("Confirm", "Are you sure you want to " +
                                        (active * 1 ? "un-delete" : "delete") +" this contact?", function(r) {
                                        if (r!='yes') {
                                            return;
                                        }
                                        
                                        
                                        new Pman.Request({
                                            url : baseURL + '/Roo/Crm_person',
                                            method : 'POST',
                                            params : {
                                                active : active,
                                                _delete_ids : _this.viewPerson.id
                                            },
                                            success : function(res){
                                                _this.viewPersonDeleteBtn.setText(active * 1 ? 'Delete' : 'Un-delete');
                                                _this.grid.footer.onClick('first');
                                                 
                                            },
                                            failure : function(e){
                                                Roo.MessageBox.alert("Error", "Fetching the updated record failed, refreshing list");
                                            
                                                _this.grid.footer.onClick('first');
                                            }
                                        });
                                    });
                                    
                                    return;
                              }

                            ]
                            text = "Delete";
                          }
                        ]
                      }
                      dataSource = Roo.data.Store {
                        boolean remoteSort = true;
                        reader = Roo.data.JsonReader {
                          Array fields = [
]                          id = "id";
                          root = "data";
                          totalProperty = "total";
                        }
                        proxy = Roo.data.HttpProxy {
                          url = baseURL + '/Roo/Crm_person';
                          method = "GET";
                        }
                        listeners [
                          load function (_self, records, options)
                          {
                                _self.removeAll();
                                
                                var person = records[0].data;
                                
                                Roo.each(Pman.Crm.Render.toViewPersonData(person), function(arr) {
                                    var section = arr[0];
                                    var rows = [];
                                    // add section data
                                    Roo.each(arr[1], function(pair) {
                                        rows.push({
                                            'section': section,
                                            'key': pair[0],
                                            'value': pair[1]
                                        });
                                    });
                                    
                                    // add section header
                                    rows.unshift({
                                        'section': '',
                                        'key': section,
                                        'value': ''
                                    });
                                    
                                    Roo.each(rows, function(row) {
                                        _self.add(new Roo.data.Record(row));
                                    });
                                    
                                });
                                
                                // mark section header as light grey
                                _self.each(function(record) {
                                    if(record.data.section === '') {
                                        _this.viewPersonGrid.getView().getCell(_self.indexOf(record), 0).style.backgroundColor = 'lightgrey';
                                        _this.viewPersonGrid.getView().getCell(_self.indexOf(record), 1).style.backgroundColor = 'lightgrey';
                                    }
                                });
                                
                                // resize action grid based on the number of rows
                                _this.el.onBrowserResize();
                                
                                _this.viewActionGrid.footer.onClick('first');
                                _this.layout.getRegion('east').getPanel(0).layout.getRegion('south').getPanel(0).layout.getRegion('center').showPanel(0);
                          }
,
                          beforeload function (_self, options)
                          {
                                options.params = options.params || {};
                                
                                if(!_this.viewPerson) {
                                    return false;
                                }
                                
                                options.params.person_id = _this.viewPerson.id;
                                options.params.join_service = 1;
                                options.params._with_comp_and_industry = 1;
                                options.params._with_mailing_lists = 1;
                                options.params._with_superseded_by_name = 1;
                                options.params._with_location_covered_names = 1;
                                options.params.limit = 1;
                          }

                        ]
                      }
                      cm[] = Roo.grid.ColumnModel {
                        Function renderer = function(v,x,r)
                        {
                              var ret = String.format('{0}', v);
                              if(r.data.section == '') {
                                  ret = '<b style="color:black;">' + ret + '</b>';
                              }
                              return ret;
                        }
                        Number width = 200;
                        dataIndex = "key";
                      }
                      cm[] = Roo.grid.ColumnModel {
                        Function renderer = function(v,x,r)
                        {
                              return v;
                        }
                        Number width = 200;
                        dataIndex = "value";
                      }
                      listeners [
                        cellclick function (_self, rowIndex, columnIndex, e)
                        {
                              if(!_this.viewPerson) {
                                  return false;
                              }
                              
                              var r = _this.viewPersonGrid.ds.getAt(rowIndex);
                              
                              if(r.data.section == 'Company' && r.data.key == 'Company Name' && columnIndex == 1) {
                                  if (!_this.filterPanel.region.visible || !_this.searchPanel.active) {
                                      _this.showHideFullSearch.fireEvent('click');
                                      _this.filterPanel.layout.getRegion('center').showPanel(0);
                                  }
                                  _this.companySel.setFromData({
                                      'id': _this.viewPerson.company_id,
                                      'name': _this.viewPerson.company_id_name
                                  });
                                  _this.grid.footer.onClick('first');
                              }
                              
                              if(r.data.section == 'Service') {
                                  Pman.Dialog.CrmAction.show({
                                      person_id: _this.viewPerson.id,
                                      action_type_id_name: 'NOTE', 
                                      company_id: _this.viewPerson.company_id,
                                      owner_id: _this.viewPerson.owner_id,
                                      owner_id_active: _this.viewPerson.owner_id_active,
                                      owner_id_name: _this.viewPerson.owner_id_name
                                  } , function() {
                                      _this.actionRequiredGrid.footer.onClick('first');
                                      _this.grid.footer.onClick('refresh');
                                      _this.viewPersonGrid.ds.load();
                                  });
                              }
                              
                              if(r.data.section == 'Person' && r.data.key == 'Email' && columnIndex == 1) {
                                  if(
                                      _this.viewPerson.email_fails * 1 >= 6 || 
                                      !(_this.viewPerson.domain_id_has_mx * 1) &&
                                      _this.viewPerson.domain_id_mx_updated.format('Y-m-d H:i:s') != '1000-01-01 00:00:00'
                                  ) {
                                      Roo.MessageBox.alert("Error", "It's an invalid address, you cant send to it");
                                      return;
                                  }
                                  Pman.Dialog.MailCreateB.show( 
                                      { 
                                          to: [{
                                              id: _this.viewPerson.id,
                                              name: _this.viewPerson.name,
                                              email: _this.viewPerson.email,
                                              tbl: 'crm_person'
                                          }],
                                          _focus_subject: 1
                                      }
                                  ); 
                              }
                        }
,
                        celldblclick function (_self, rowIndex, columnIndex, e)
                        {
                              if(!_this.viewPerson) {
                                  return false;
                              }
                                  
                              var r = _this.viewPersonGrid.ds.getAt(rowIndex);
                              
                              if(r.data.section != '' && r.data.section != 'Service') {
                                  _this.dialog.show( {id : _this.viewPerson.id}, function(res) {
                                      _this.grid.footer.onClick('first');
                                      _this.actionRequiredGrid.footer.onClick('first');
                                      _this.viewPersonGrid.ds.load();
                                  });
                              }
                        }
,
                        render function (grid)
                        {
                              _this.viewPersonGrid = this;
                        }

                      ]
                      loadMask = true;
                    }
                    region = "center";
                    tableName = "Crm_person";
                    title = "Person";
                  },
                  Roo.NestedLayoutPanel {
                    layout = Roo.BorderLayout {
                      center = Roo.LayoutRegion {}
                      east = Roo.LayoutRegion {
                        hidden = true;
                        width = 200;
                      }
                      south = Roo.LayoutRegion {
                        height = 60;
                      }
                      [
                        Roo.ContentPanel {
                          autoScroll = true;
                          fitContainer = true;
                          fitToFrame = true;
                          toolbar = Roo.Toolbar {
                            [
                              Roo.Toolbar.Fill {},
                              Roo.Toolbar.Button {
                                listeners [
                                  click function (_self, e)
                                  {
                                        if (!_this.imageView.getSelectedNodes().length) {
                                         Roo.MessageBox.alert("Error", "Select an Image");
                                         return;
                                       }
                                       var id  = _this.imageView.getNodeData(_this.imageView.getSelectedNodes()[0]).id;
