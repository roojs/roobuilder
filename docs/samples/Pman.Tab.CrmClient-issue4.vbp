                                      width = 195;
                                    },
                                    Roo.form.DateField {
                                      Boolean useIso = true;
                                      fieldLabel = "To";
                                      format = "Y-m-d";
                                      listeners [
                                        render function (_self)
                                        {
                                              _this.dateTo = this;
                                        }
,
                                        select function (combo, date)
                                        {
                                              _this.grid.footer.onClick('first');
                                        }

                                      ]
                                      name = "to_date";
                                      width = 195;
                                    }
                                  ]
                                  legend = "Last Activity Search Date Range";
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.dateRange = this;
                                    }

                                  ]
                                },
                                Roo.form.ComboBox {
                                  Number width = 225;
                                  allowBlank = false;
                                  displayField = "value";
                                  editable = false;
