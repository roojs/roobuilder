                                          if(!_this.viewPerson) {
                                              Roo.MessageBox.alert('Error', 'Please select a person first');
                                              return false;
                                          }
                                          
                                          var param = {
                                              person_id : _this.viewPerson.id,
                                              action_type_id_name: 'NOTE',
                                              company_id: _this.viewPerson.company_id,
                                              owner_id: _this.viewPerson.owner_id,
                                              owner_id_active: _this.viewPerson.owner_id_active,
                                              owner_id_name: _this.viewPerson.owner_id_name
                                          };
                                          
                                          var ca = _this.viewPerson.crm_contact_again_notify_date;
                                          if(!(ca instanceof Date)) {
                                              ca = new Date(ca);
                                          }
                                          ca.setHours(0,0,0,0);
                                          var today = new Date();
                                          if(ca >= today) {
                                              param.contact_again = ca;
                                          }
                                          
                                          Pman.Dialog.CrmAction.show( param , function() {
                                              _this.viewPersonGrid.ds.load();
                                              _this.actionRequiredGrid.footer.onClick('first');
                                          });
                                    }

                                  ]
                                  text = "General Note";
                                },
                                Roo.menu.Item {
                                  listeners [
                                    click function()
                                    {
                                          var s = _this.viewActionGrid.getSelectionModel().getSelected();
                                          
                                          if (!s)  {
                                              Roo.MessageBox.alert("Error", "Select an activity");
                                              return;
                                          }
                                          
                                          if(s.data.id * 1 == -1) {
                                              Roo.MessageBox.alert("Error", "You cannot edit Contact Again");
                                              return;
                                          }
                                          
                                          if(!_this.viewPerson) {
                                              Roo.MessageBox.alert('Error', 'Please select a person first');
                                              return false;
                                          }
                                          
                                          Pman.Dialog.CrmAction.show({
                                              id: s.data.id,
                                              company_id: _this.viewPerson.company_id,
                                              owner_id: _this.viewPerson.owner_id,
                                              owner_id_active: _this.viewPerson.owner_id_active,
                                              owner_id_name: _this.viewPerson.owner_id_name
                                          }, function(){
                                              _this.viewActionGrid.footer.onClick('first');
                                              _this.actionRequiredGrid.footer.onClick('first');
                                              _this.grid.footer.onClick('refresh');
                                          });
                                    }

                                  ]
                                  text = "Edit";
                                },
                                Roo.menu.Item {
                                  listeners [
                                    click function()
                                    {
                                          if(
                                              // unassigned contacts
                                              !(_this.viewPerson.owner_id * 1) &&
                                              // cannot edit if the staff doesn't have the edit permission 'Crm.View_Unassigned_Contacts'
                                              !Pman.hasPerm('Crm.View_Unassigned_Contacts', 'E')
                                              ||
                                              // current staff's contacts
                                              _this.viewPerson.owner_id * 1 && _this.viewPerson.owner_id != Pman.Login.authUser.id && _this.viewPerson.owner_id_active * 1 && 
                                              // cannot edit if the staff doesn't have the edit permission 'Crm.View_Other_Contacts'
                                              !Pman.hasPerm('Crm.View_Other_Contacts', 'E')
                                              ||
                                              // old staff's contacts
                                              _this.viewPerson.owner_id * 1 && _this.viewPerson.owner_id != Pman.Login.authUser.id && !(_this.viewPerson.owner_id_active * 1) &&
                                              // cannot edit if the staff has none of the edit permissions ('Crm.View_Other_Contacts' or 'Crm.View_Unassigned_Contacts')
                                              !Pman.hasPerm('Crm.View_Unassigned_Contacts', 'E') && !Pman.hasPerm('Crm.View_Other_Contacts', 'E')
                                          ) {
                                              Roo.MessageBox.alert('Error', "You don't have the permission to delete the activities for this contact");
                                              return;
                                          }
                                                  
                                          var s = _this.viewActionGrid.getSelectionModel().getSelected();
                                          
                                          if (!s)  {
                                              Roo.MessageBox.alert("Error", "Select an activity");
                                              return;
                                          }
                                          
                                          if(s.data.id * 1 == -1) {
                                              Roo.MessageBox.alert("Error", "You cannot delete Contact Again");
                                              return;
                                          }
                                          
                                          Pman.request({
                                             url: baseURL+'/Roo/Crm_action',
                                             params : {
                                                 'id' : s.data.id,
                                                 'deleted_by_id' : Pman.Login.authUser.id
                                             },
                                             success : function  () {
                                                 _this.viewActionGrid.ds.load({});
                                                 _this.actionRequiredGrid.footer.onClick('first');
                                             }
                                          });
                                    }

                                  ]
                                  text = "Delete";
                                },
                                Roo.menu.Item {
                                  listeners [
                                    click function()
                                    {
                                          if(
                                              // unassigned contacts
                                              !(_this.viewPerson.owner_id * 1) &&
                                              // cannot edit if the staff doesn't have the edit permission 'Crm.View_Unassigned_Contacts'
                                              !Pman.hasPerm('Crm.View_Unassigned_Contacts', 'E')
                                              ||
                                              // current staff's contacts
                                              _this.viewPerson.owner_id * 1 && _this.viewPerson.owner_id != Pman.Login.authUser.id && _this.viewPerson.owner_id_active * 1 && 
                                              // cannot edit if the staff doesn't have the edit permission 'Crm.View_Other_Contacts'
                                              !Pman.hasPerm('Crm.View_Other_Contacts', 'E')
                                              ||
                                              // old staff's contacts
                                              _this.viewPerson.owner_id * 1 && _this.viewPerson.owner_id != Pman.Login.authUser.id && !(_this.viewPerson.owner_id_active * 1) &&
                                              // cannot edit if the staff has none of the edit permissions ('Crm.View_Other_Contacts' or 'Crm.View_Unassigned_Contacts')
                                              !Pman.hasPerm('Crm.View_Unassigned_Contacts', 'E') && !Pman.hasPerm('Crm.View_Other_Contacts', 'E')
                                          ) {
                                              Roo.MessageBox.alert('Error', "You don't have the permission to clear contact again / enquiry for this contact");
                                              return;
                                          }
                                          
                                          var s = _this.viewActionGrid.getSelectionModel().getSelected();
                                          
                                          if (!s)  {
                                              Roo.MessageBox.alert("Error", "Select an activity");
                                              return;
                                          }
                                          
                                          if(
                                              (s.data.id * 1 != -1 || !s.json.action_id) // NOT contact again
                                              && // AND
                                              (s.data.action_type_id_name != 'ENQUIRY') // NOT enquiry
                                          ) {
                                              Roo.MessageBox.alert("Error", "You can only clear Contact Again or Enquiry");
                                              return;
                                          }
                                          
                                          var actionId = (s.data.action_type_id_name == 'ENQUIRY') ? s.data.id : s.json.action_id;
                                          
                                          Pman.Dialog.CrmContactAgainClear.show(
                                              {
                                                  '_clear_contact_again_ids': actionId
                                              },
                                              function() {
                                                  _this.viewActionGrid.ds.load({});
                                                  _this.actionRequiredGrid.footer.onClick('first');
                                              }
                                          );
                                    }

                                  ]
                                  text = "Clear Contact Again / Enquiry";
                                },
                                Roo.menu.Item {
                                  listeners [
                                    click function()
                                    {
                                          if(!_this.viewPerson) {
                                              Roo.MessageBox.alert('Error', 'Please select a person first');
                                              return false;
                                          }
                                          
                                          if (!(_this.viewPerson.active * 1)) {
                                              Roo.MessageBox.alert('Error', "This contact is deleted. Un-delete it before adding activity.");
                                              return false;
                                          }
                                          
                                          var params = {
                                              _to_person_id : _this.viewPerson.id,
                                              name : _this.viewPerson.name,
                                              email : _this.viewPerson.email,
                                              company_id_name : _this.viewPerson.company_id_name
                                          };
                                          
                                          Pman.Dialog.CrmImportActivity.show(params, function() {
                                              _this.viewPersonGrid.ds.load();
                                              _this.actionRequiredGrid.footer.onClick('first');
                                              _this.grid.footer.onClick('first');
                                          });
                                    }

                                  ]
                                  text = "Import History";
                                }
                              ]
                            }
                            listeners [
                              render function (_self)
                              {
                                    _this.viewPersonAddActivityBtn = _self;
                              }

                            ]
                            text = "Add Activity / Notes";
                          },
                          Roo.Toolbar.Button {
                            String text = "Update Service Status";
                            listeners [
                              render function (_self)
                              {
                                    _this.viewPersonUpdateServiceBtn = _self;
                              }
,
                              click function (_self, e)
                              {
                                    if(!_this.viewPerson) {
                                        Roo.MessageBox.alert('Error', 'Please select a person first');
                                        return false;
                                    }
                                    
                                    Pman.Dialog.CrmAction.show({
                                        person_id: _this.viewPerson.id,
                                        action_type_id_name: 'NOTE', 
                                        company_id: _this.viewPerson.company_id,
                                        owner_id: _this.viewPerson.owner_id,
                                        owner_id_active: _this.viewPerson.owner_id_active,
                                        owner_id_name: _this.viewPerson.owner_id_name
                                    } , function() {
                                        _this.actionRequiredGrid.footer.onClick('first');
                                        _this.grid.footer.onClick('refresh');
                                        _this.viewPersonGrid.ds.load();
                                    });
                              }

                            ]
                          }
                        ]
                      }
                      footer = Roo.PagingToolbar {
                        displayInfo = true;
                        displayMsg = "Displaying Activities {0} - {1} of {2}";
                        emptyMsg = "No Activity found";
                        [
                          Roo.Toolbar.Button {
                            Boolean enableToggle = true;
                            Boolean pressed = false;
                            String text = "Show Deleted";
                            listeners [
                              render function (_self)
                              {
                                    _this.showHideActionBtn = this;
                              }
,
                              toggle function (_self, pressed)
                              {
                                    (function()  { 
                                        _self.setText(pressed ? 'Hide Deleted' : 'Show Deleted');
                                        _this.viewActionGrid.footer.onClick('first'); 
                                    }).defer(100);
                                 
                              }

                            ]
                          }
                        ]
                        pageSize = 25;
                      }
                      dataSource = Roo.data.Store {
                        boolean remoteSort = true;
                        reader = Roo.data.JsonReader {
                          Array fields = [
    {
        'name': 'id',
        'type': 'int'
    }
]                          id = "id";
                          root = "data";
                          totalProperty = "total";
                        }
                        proxy = Roo.data.HttpProxy {
                          url = baseURL + '/Roo/Crm_action';
                          method = "GET";
                        }
                        listeners [
                          load function (_self, records, options)
                          {
                                var expanded = 0;
                                Roo.each(records, function (record, i)  {
                                    // expand first two (non contact again) actions
                                    if(record.id * 1 > 0 && expanded < 2) {
                                        record.set('isExpanded', 1);
                                        expanded++;
                                        return;
                                    }
                                    record.set('isExpanded', -1);
                                }, this);
                                _this.messageGrid.footer.onClick('first');
                          }
,
                          beforeload function (_self, options)
                          {
                                options.params = options.params || {};
                                
                                if(!_this.viewPerson) {
                                    return false;
                                }
                                
                                options.params['_for_person'] = _this.viewPerson.id;
                                options.params['_for_company'] = _this.viewPerson.company_id;
                                options.params['history'] = 1;
                                options.params['!action_type_id_name[0]'] = 'CRMMAILSENT';
                                options.params['!action_type_id_name[1]'] = 'INVALIDCONTACT';
                                options.params['!action_type_id_name[2]'] = 'CREATED';
                                options.params['!action_type_id_name[3]'] = 'UPDATED';
                                options.params['sort'] = 'action_dt';
                                options.params['dir'] = 'DESC';
                                if(!_this.showHideActionBtn.pressed) {
                                    options.params['deleted_by_id'] = 0;
                                }  
                                if(_this.actionSearchBox.getValue().length) {
                                    options.params._search_notes = _this.actionSearchBox.getValue();
                                }
                          }

                        ]
                      }
                      cm[] = Roo.grid.ColumnModel {
                        Function renderer = function(v, x, r)
                        {
                              
                              if(r.json.is_contact_again_row * 1 && r.data.contact_again_notify_id_act_start != "") {
                                  var actStart = r.data.contact_again_notify_id_act_start;
                                  var now = new Date();
                                  now.setHours(0,0,0);
                                  actStart.setHours(0,0,0);
                                  
                                  var color = 'background-color:red; color:white;';
                                  if(actStart > now) {
                                      color = 'color:green';
                                  }
                                  
                                  return String.format('<span style="font-weight:bold; {0}">Contact Again</span>', color);
                              }
                              
                              var type = r.data.action_type_id_display_name;
                              
                              if(['MEETING', 'PHONE', 'NOTE', 'FIRSTMEETING'].includes(r.data.action_type_id_name)) {
                                  // no contact again
                                  type = String.format(
                                      '<b>{0}</b><i> - No further action required</i>', 
                                      r.data.action_type_id_display_name
                                  );
                                  
                                  // has contact again
                                  if(r.data.contact_again_notify_id * 1) {
                                      type = String.format(
                                          '<b>{0} - Contact again {1}</b>', 
                                          r.data.action_type_id_display_name,
                                          r.data.contact_again_notify_id_act_start != '' ? 
                                              r.data.contact_again_notify_id_act_start.format('d/M/Y')
                                              : ''
                                      );
                                  }
                              }
                              
                              var fullNotes = r.data.notes.replace(/\n/g,'<br/>');
                          
                              if(r.data.original_id * 1) {
                                  fullNotes += '<br><br><i>Previous version of notes:</i><br/><s>' + r.data.original_id_notes.replace(/\n/g,'<br/>') + '</s>';
                              }
                              
                              var abbrNotes = r.data.action_dt.format('d M Y') + ' - ' + r.data.notes.substr(0,60) + '...';
                              
                              // show abbreivation only when the cell is collapsed AND (the note is long OR there is a old version)
                              var notes = (
                                  r.get('isExpanded') === -1 // collapsed
                                  &&
                                  (
                                      r.data.notes.length > 60 // long notes
                                      ||
                                      r.data.original_id_notes.length * 1 // with old version
                                  )
                              ) ? abbrNotes : fullNotes;
                              
                              var ret = '<div style="cursor:pointer;"><div>' + type + '</div><br/><div style="white-space:normal;">' + notes + '</div></div>';
                              return r.data.deleted_by_id * 1 ? '<s>' + ret + '</s>' : ret;
                        }
                        String header = "Activity";
                        dataIndex = "notes";
                      }
                      cm[] = Roo.grid.ColumnModel {
                        Function renderer = function(v, x, r)
                        {
                              
                              // Contact Again (only when act_start is set)
                              if(
                                  typeof(r.json.is_contact_again_row) != 'undefined' 
                                  && 
                                  r.json.is_contact_again_row * 1
                                  && 
                                  r.data.contact_again_notify_id_act_start != ""
                              ) {
                                  var actStart = r.data.contact_again_notify_id_act_start;
                                  var now = new Date();
                                  now.setHours(0,0,0);
                                  actStart.setHours(0,0,0);
                                  
                                  var color = 'background-color:red; color:white;';
                                  if(actStart > now) {
                                      color = 'color:green';
                                  }
                                  var date = actStart.format('d M Y');
                                  var ret = String.format("<span style='font-weight:bold; {0}'>{1}</span>", color, date);
                                  
                                  return ret;
                              }
                              
                              var yest = (new Date()).add(Date.DAY, -6);
                              
                              var date = r.data.action_dt.format('D h:ia');
                              if (v < yest) {
                                  date = r.data.action_dt.format('d M Y');
                              }
                              
                              var qtip = r.data.action_dt.format('d M Y h:ia');
                              
                              var ret = String.format("<span qtip='{0}'>{1}</span>", qtip, date);
                              
                              return r.data.deleted_by_id * 1 ? "<s>" + ret + "</s>" : ret;
                        }
                        Number width = 100;
                        String align = "right";
                        String header = "Date";
                        dataIndex = "action_dt";
                      }
                      listeners [
                        cellclick function (_self, rowIndex, columnIndex, e)
                        {
                              r = _self.ds.getAt(rowIndex);
                              
                              if(columnIndex != 0) {
                                  return;
                              }
                              var r = _this.viewActionGrid.ds.getAt(rowIndex);
                              
                              setTimeout(() => r.set('isExpanded', r.get('isExpanded') * -1), 100);
                        }
,
                        render function (grid)
                        {
                              _this.viewActionGrid = this;
                        }

                      ]
                      loadMask = true;
                    }
                    listeners [
                      render function (_self)
                      {
                            _this.viewActionPanel = this;
                      }

                    ]
                    region = "center";
                    tableName = "Crm_action";
                    title = "Activity";
                  },
                  Roo.GridPanel {
                    background = false;
                    fitContainer = true;
                    fitToframe = true;
                    grid = Roo.grid.Grid {
                      autoExpandColumn = "event_id_remarks";
                      sm = Roo.grid.RowSelectionModel {
                        singleSelect = true;
                      }
                      dataSource = Roo.data.Store {
                        sortInfo = { field : 'act_when', direction: 'DESC' };
                        proxy = Roo.data.HttpProxy {
                          url = baseURL + '/Roo/Core_notify.php';
                          method = "GET";
                        }
                        reader = Roo.data.JsonReader {
                          fields = [
    {
        'name': 'id',
        'type': 'int'
    }
]                          id = "id";
                          root = "data";
                          totalProperty = "total";
                        }
                        listeners [
                          beforeload function (_self, options)
                          {
                                options.params = options.params || {};
                                
                                if(!_this.viewPerson) {
                                    return false;
                                }
                                
                                options.params.ontable = 'crm_mailing_list_queue';
                                
                                options.params.crm_person_id = _this.viewPerson.id;
                                options.params['query[status]'] = _this.status.getValue();
                                var columns = _this.messageGrid.getColumnModel().getColumnsBy(function() {
                                    return true;
                                }).map(function(x) {
                                    return x.dataIndex;
                                });
                                
                                columns = columns.concat([
                                    'event_id'
                                ]);
                                
                                options.params._columns = columns.join(',');
                          }
,
                          load function (_self, records, options)
                          {
                                _this.viewActivityGrid.footer.onClick('first');
                          }

                        ]
                        remoteSort = true;
                      }
                      footer = Roo.PagingToolbar {
                        displayInfo = true;
                        displayMsg = "Displaying Notifications {0} - {1} of {2}";
                        emptyMsg = "No Notifications found";
                        [
                          Roo.Toolbar.Button {
                            listeners [
                              click function (_self, e)
                              {
                                    new Pman.Download({
                                        grid : _this.messageGrid
                                    });
                                    Roo.MessageBox.alert("Notice", "Report will download shortly");
                              }

                            ]
                            text = "Download";
                          }
                        ]
                        pageSize = 25;
                      }
                      toolbar = Roo.Toolbar {
                        [
                          Roo.form.ComboBox {
                            allowBlank = false;
                            displayField = "fname";
                            editable = false;
                            fieldLabel = "Status";
                            hiddenName = "cm_status";
                            store = Roo.data.SimpleStore {
                              data = [ 
    [ 'ALL', "All"],
    [ 'SUCCESS' , "Delivered Succesfully"],
    [ 'FAILED', "Delivery Failed"] ,
    [ 'PENDING', "Pending Delivery"] 
]
                              fields = [  'ftype', 'fname'];
                            }
                            listWidth = 200;
                            listeners [
                              render function (_self)
                              {
                                  _this.status = _self;
                              }
,
                              select function (combo, record, index)
                              {
                                    _this.messageGrid.footer.onClick('first');
                              }

                            ]
                            mode = "local";
                            name = "cm_status_name";
                            triggerAction = "all";
                            value = "ALL";
                            valueField = "ftype";
                            width = 150;
                          },
                          Roo.Toolbar.Fill {},
                          Roo.Toolbar.Button {
                            icon = rootURL + '/Pman/templates/images/trash.gif';
                            cls = "x-btn-text-icon";
                            listeners [
                              click function()
                              {
                                    var s = _this.messageGrid.getSelectionModel().getSelected();
                                    
                                    if(!s || s.data.id * 1 < 1){
                                        return;
                                    }
                                    
                                    if(s.data.msgid.length){
                                        Roo.MessageBox.alert("Error", "This notification has been sent!");
                                        return;
                                    }
                                    
                                    Pman.genericDelete(_this, 'core_notify'); 
                              }

                            ]
                            text = "Remove from Queue";
                          }
                        ]
                      }
                      colModel[] = Roo.grid.ColumnModel {
                        renderer = function(v) 
                        {
                              return String.format('{0}', v );
                        }
                        dataIndex = "id";
                        header = "Ref#";
                        width = 50;
                      }
                      colModel[] = Roo.grid.ColumnModel {
                        renderer = function(v) 
                        {
                              return String.format('{0}', (v) ? v.format('d/M/Y h:ia') : '' );
                        }
                        dataIndex = "sent";
                        header = "Sent Date";
                        width = 120;
                      }
                      colModel[] = Roo.grid.ColumnModel {
                        renderer = function(v)
                        {
                              return String.format('<span style="color:{0}";>{1}</span>', v ? 'green': 'red', v ? 'YES' : 'NO');
                        }
                        dataIndex = "msgid";
                        header = "Delivered";
                        width = 75;
                      }
                      colModel[] = Roo.grid.ColumnModel {
                        renderer = function(v) { return String.format('<span qtip="{0}">{0}</span>', v ); };
                        dataIndex = "ontable_id_message_id_subject";
                        header = "Message";
                        width = 200;
                      }
                      colModel[] = Roo.grid.ColumnModel {
                        renderer = function(v,x,r)
                        {
                              if(r.data.msgid.length != 0) {
                                  return '';
                              }
                              return String.format('<span style="color:red;" qtip="{0}">{0}</span>', v );
                        }
                        dataIndex = "event_id_remarks";
                        header = "Error";
                        width = 200;
                      }
                      listeners [
                        celldblclick function (_self, rowIndex, columnIndex, e)
                        {
                              var r = _self.ds.getAt(rowIndex);
                              if(r.data.event_id) {
                                  Pman.Dialog.CoreViewWebsite.show({url: baseURL + '/Admin/EventView/' + r.data.event_id + '.html'});
                              }
                              
                        }
,
                        render function() 
                        {
                              _this.messageGrid = this;
                        }

                      ]
                      loadMask = true;
                    }
                    listeners [
                      render function (_self)
                      {
                            _this.messagePanel = this;
                      }

                    ]
                    region = "center";
                    tableName = "Groups";
                    title = "EDM Messages Sent / Read";
                  },
                  Roo.GridPanel {
                    Boolean background = false;
                    fitContainer = true;
                    fitToframe = true;
                    grid = Roo.grid.Grid {
                      String autoExpandColumn = "notes";
                      sm = Roo.grid.RowSelectionModel {
                        singleSelect = true;
                      }
                      dataSource = Roo.data.Store {
                        boolean remoteSort = true;
                        reader = Roo.data.JsonReader {
                          Array fields = [
    {
        'name': 'id',
        'type': 'int'
    }
]                          id = "id";
                          root = "data";
                          totalProperty = "total";
                        }
                        proxy = Roo.data.HttpProxy {
                          url = baseURL + '/Roo/Crm_action';
                          method = "GET";
                        }
                        listeners [
                          beforeload function (_self, options)
                          {
                                options.params = options.params || {};
                                
                                if(!_this.viewPerson) {
                                    return false;
                                }
                                
                                options.params['person_id'] = _this.viewPerson.id;
                                options.params['action_type_id_name[0]'] = 'CREATED';
                                options.params['action_type_id_name[1]'] = 'UPDATED';
                                options.params['sort'] = 'action_dt';
                                options.params['dir'] = 'DESC';
                                options.params['_import_event'] = 1;
                                options.params['_unsubscribe_event'] = 1;
                                options.params['_event_audit'] = 1;
                          }

                        ]
                      }
                      footer = Roo.PagingToolbar {
                        displayInfo = true;
                        displayMsg = "Displaying Activities {0} - {1} of {2}";
                        emptyMsg = "No Activity found";
                        pageSize = 25;
                      }
                      cm[] = Roo.grid.ColumnModel {
                        Function renderer = function(v, x, r)
                        {
                              var qtip = '';
                              Roo.each(r.data.event_audit, function(audit) {
                                  qtip = qtip + audit.name + ' SET TO ' + audit.newvalue + '<br>'; 
                              });
                              return '<b qtip="' + qtip.replace(/"/g, '&quot;') + '">' + v + '</b>';
                        }
                        String header = "Activity";
                        dataIndex = "action_type_id_display_name";
                      }
                      cm[] = Roo.grid.ColumnModel {
                        String header = "Who";
                        dataIndex = "staff_id_name";
                      }
                      cm[] = Roo.grid.ColumnModel {
                        Function renderer = function(v, x, r)
                        {
                              // Contact Again (only when act_start is set)
                              if(
                                  typeof(r.json.is_contact_again_row) != 'undefined' 
                                  && 
                                  r.json.is_contact_again_row * 1
                                  && 
                                  r.data.contact_again_notify_id_act_start != ""
                              ) {
                                  var ret = r.data.contact_again_notify_id_act_start.format('d M Y');
                                  return String.format("<span style='color:red;'>{0}</span>", ret);
                              }
                              
                              var yest = (new Date()).add(Date.DAY, -6);
                              
                              var ret = r.data.action_dt.format('D h:ia');
                              if (v < yest) {
                                  ret = r.data.action_dt.format('d M Y');
                              }
                              
                              var qtip = r.data.action_dt.format('d M Y h:ia');
                              
                              return String.format("<span qtip='{0}'>{1}</span>", qtip, ret);
                        }
                        Number width = 100;
                        String align = "right";
                        String header = "Date";
                        dataIndex = "action_dt";
                      }
                      listeners [
                        cellclick function (_self, rowIndex, columnIndex, e)
                        {
                              if(columnIndex != 0) {
                                  return;
                              }
                              var r = _this.viewActivityGrid.ds.getAt(rowIndex);
                        }
,
                        render function (grid)
                        {
                              _this.viewActivityGrid = this;
                        }

                      ]
                      loadMask = true;
                    }
                    listeners [
                      render function (_self)
                      {
                            _this.viewActivityPanel = this;
                      }

                    ]
                    region = "center";
                    tableName = "Crm_action";
                    title = "Full Activity Log";
                  }
                ]
              }
              region = "south";
            }
          ]
        }
        region = "east";
      }
    ]
  }
  listeners [
    activate function (_self)
    {
          window.addEventListener("resize", _self.onBrowserResize);
          
          if(typeof(_this.dateRange) != 'undefined') {
              _this.dateRange.hide();
          }
          if(typeof(_this.clientOfCompetitorSel) != 'undefined') {
              _this.clientOfCompetitorSel.hide();
          }
          
          if(_this.actionRequiredGrid && _this.actionRequiredGrid.ds) {
              _this.actionRequiredGrid.footer.onClick('first');
          }
    }
,
    deactivate function (_self)
    {
          window.removeEventListener("resize", _self.onBrowserResize);
    }
,
    render function (_self)
    {
          Pman.on('load', function(){
              _this.layout.getRegion('east').resizeTo('50%');
              _this.layout.getRegion('east').collapse();
              _this.layout.getRegion('east').hide();
          });
    }

  ]
  region = "center";
  title = "Contacts";
  methods [
    onBrowserResize function()
    {
          _this.layout.getRegion('east').getActivePanel().layout.getRegion('south').resizeTo('100%');
          
          
          var totalHeight = _this.layout.getRegion('east').getActivePanel().getEl().getHeight();
          
          var scroller = _this.viewPersonGrid.getView().scroller;
          var scrollHeight = scroller.dom.scrollHeight;
          
          var viewPersonPanelHeight = scrollHeight + 24 + 21; // 24: toolbar height, 21: tab height
          
          var activityPanelHeight = totalHeight - 5 - viewPersonPanelHeight; // 5: split height
          
          _this.layout.getRegion('east').getActivePanel().layout.getRegion('south').resizeTo(activityPanelHeight);
          
          // minimum height for activity panel: 50% of total height
          var minimumActivityPanelHeight = totalHeight / 2;
          
          _this.layout.getRegion('east').getActivePanel().layout.getRegion('south').resizeTo(
              Math.max(activityPanelHeight, minimumActivityPanelHeight)
          );
    }

  ]
}
