                                  if(_this.grid) {
                                      _this.grid.footer.onClick('first');
                                  }
                            }
,
                            render function (_self)
                            {
                                  _this.companyPanel = _self;
                            }

                          ]
                          region = "center";
                        }
                      ]
                    }
                    listeners [
                      activate function (_self)
                      {
                            _self.layout.getRegion('center').showPanel(0);
                      }
,
                      render function (_self)
                      {
                            _this.filterPanel = _self;
                      }

                    ]
                  },
                  Roo.GridPanel {
                    autoScroll = true;
                    background = true;
                    fitContainer = true;
                    fitToframe = true;
                    grid = Roo.grid.Grid {
                      autoExpandColumn = "company_id_name";
                      sm = Roo.grid.RowSelectionModel {
                        singleSelect = true;
                      }
                      dataSource = Roo.data.Store {
                        proxy = Roo.data.HttpProxy {
                          url = baseURL + '/Roo/crm_person.php';
                          method = "GET";
                        }
                        reader = Roo.data.JsonReader {
                          fields = [
    {
        'name': 'id',
        'type': 'int'
    },
    {
        'name': 'services_sort',
        'type': 'int'
    }
]                          id = "id";
                          root = "data";
                          totalProperty = "total";
                        }
                        listeners [
                          beforeload function (_self, options)
                          {
                                if(Pman.building) {
                                    return false;
                                }
                                options.params = _this.grid.buildParams(options.params);
                          }
,
                          load function (_self, records, options)
                          {
                                var canBulkEdit = true;
                                var hasNegativeId = false;
                                var hasEmail = false;
                                var hasPhone = false;
                                
                                Roo.each(records, function(r) {
                                    if(r.data.id * 1 < 0) {
                                        canBulkEdit = false;
                                        hasNegativeId = true;
                                    }
                                    if(r.data.email && r.data.email.trim() !== '') {
                                        hasEmail = true;
                                    }
                                    if(r.data.phone && r.data.phone.trim() !== '') {
                                        hasPhone = true;
                                    }
                                });
                                
                                _this.bulkChangeMenu.show();
                                if(!canBulkEdit) {
                                    _this.bulkChangeMenu.hide();
                                }
                                
                                // Show email and phone columns if there are records with negative IDs
                                if(hasNegativeId) {
                                    var emailColIndex = _this.grid.colModel.findColumnIndex('email');
                                    var phoneColIndex = _this.grid.colModel.findColumnIndex('phone');
                                    
                                    if(emailColIndex >= 0 && hasEmail) {
                                        _this.grid.colModel.setHidden(emailColIndex, false);
                                    }
                                    if(phoneColIndex >= 0 && hasPhone) {
                                        _this.grid.colModel.setHidden(phoneColIndex, false);
                                    }
                                }
                          }
,
                          update function (_self, record, operation)
                          {
                                if (operation != Roo.data.Record.COMMIT) {
                                    return;
                                }
                                // got commit..
                                new Pman.Request({
                                    url : baseURL + '/Roo/Crm_person',
                                    method : 'POST',
                                    params : {
                                        id : record.data.id,
                                        crm_is_unsubscribed : record.data.crm_is_unsubscribed
                                    
                                    }, 
                                    success : function(res) {
                                        //Roo.log(data);
                                        // update the ID if it's not set..
                                        //if (record.data.id * 1 < 1) {
                                        //    record.set('id', res.data.id);
                                        //}
                                        
                                    }
                                });
                          }

                        ]
                        remoteSort = true;
                      }
                      footer = Roo.PagingToolbar {
                        displayInfo = true;
                        displayMsg = "Displaying Person{0} - {1} of {2}";
                        emptyMsg = "No Person found";
                        [
                          Roo.Toolbar.Button {
                            Boolean hidden = (function()
                            {
                                  return !Pman.hasPerm('Crm.Download', 'S')
                            }
                            String text = "Download";
                            listeners [
                              click function (_self, e)
                              {
                                    if(!Pman.hasPerm('Crm.Download', 'S')){
                                        return;
                                    }
                                    
                                    new Pman.Download({
                                        grid : _this.grid
                                    });
                                    
                                    Roo.MessageBox.alert("Downloading", "File is downloading");
                              }

                            ]
                          },
                          Roo.Toolbar.Button {
                            String text = "Import Contacts";
                            listeners [
                              click function (_self, e)
                              {
                                    var dbCols = [
                                        [ '', "--not set--"],
                                        [ 'firstname', "First Name", false],
                                        [ 'lastname', "Last Name", false],
                                        [ 'nametype1', "name ('given name family name')", false],
                                        [ 'nametype2', "name ('family name given name')", false],
                                        [ 'role', 'Job Title', false],
                                        [ 'lang', "Language Spoken", false],
                                        [ 'phone_mobile', 'Mobile Phone', false],
                                        [ 'phone_direct', "Phone Direct", false],
                                        [ 'email', "Email", true],
                                        [ 'alt_email', "Secondary Email", false],
                                        [ 'fax', "Fax", false],
                                        [ 'company_name', "Company Name", true],
                                        [ 'company_website', "Website", false],
                                        [ 'company_type', 'Company Type', true],
                                        [ 'client_industry', 'Client Industry', false],
                                        [ 'client_of_competitor', 'Client of Competitor', false],
                                        [ 'office_country', 'Country', false]
                                    ];
                                    if(Pman.hasPerm("Crm.ChangeOwner", "S")) {
                                        dbCols.push([ 'owner', 'Contact Owner', false]);
                                    }
                                    Pman.Dialog.Image.show({
                                        _url : baseURL + '/Crm/Import/ImportAddress'
                                
                                    }, function (data) {
                                        Pman.Dialog.PreviewHeaderImport.show({
                                            url: baseURL + '/Crm/Import/ImportAddress',
                                            fileId: data.id,
                                            fileName: data.filename,
                                            data: data.data,
                                            dbCols: dbCols,
                                            validateCols: [
                                                {name: 'email', type: 'email'},
                                                {name: 'alt_email', type: 'email'}
                                            ],
                                            urlCols: []
                                        });
                                    });
                              }

                            ]
                          },
                          Roo.Toolbar.Button {
                            Boolean enableToggle = true;
                            Boolean pressed = false;
                            listeners [
                              render function (_self)
                              {
                                    _this.selectToggle = _self;
                              }
,
                              toggle function (_self, pressed)
                              {
                                    _self.setText(pressed ? 'Multi Select' : 'Single Select');
                                    _this.grid.getSelectionModel().singleSelect = !_this.grid.getSelectionModel().singleSelect;
                                    _this.grid.getSelectionModel().clearSelections();
                                    
                                    if(typeof(_this.sendEmailToSelected) != 'undefined') {
                                        _this.sendEmailToSelected.show();
                                        _this.bulkUpdateSelected.show();
                                        _this.addSelectedToMailingList.show();
                                        if(_this.grid.getSelectionModel().singleSelect) {
                                            _this.sendEmailToSelected.hide();
                                            _this.bulkUpdateSelected.hide();
                                            _this.addSelectedToMailingList.hide();
                                        }
                                    }
                              }

                            ]
                            text = "Single Select";
                          },
                          Roo.Toolbar.Button {
                            Boolean enableToggle = true;
                            Boolean pressed = false;
                            String text = "Show Deleted";
                            listeners [
                              render function (_self)
                              {
                                    _this.deletedToggle = this;
                              }
,
                              toggle function (_self, pressed)
                              {
                                    (function()  { 
                                        _self.setText(!pressed ? 'Show Deleted' : 'Hide Deleted');
                                        _this.grid.footer.onClick('first'); 
                                    }).defer(100);
                                 
                              }

                            ]
                          },
                          Roo.Toolbar.Button {
                            String text = "Show / Hide Columns";
                            listeners [
                              click function (_self, e)
                              {
                                   
                                     var ci = -1;
                                    _this.grid.colModel.config.forEach(function(cfg,i) {
                                        if (!cfg.hidden && ci < 0) {
                                            ci = i;
                                        }
                                    });
                                   _this.grid.view.beforeColMenuShow();
                                   _this.grid.getView().handleHdCtx(_this.grid, ci, e);
                                   
                                   _this.grid.view.hmenu.items.get(6).activate(true); // show submenu.
                              }

                            ]
                          },
                          Roo.Toolbar.Button {
                            menu = Roo.menu.Menu {
                              [
                                Roo.menu.Item {
                                  listeners [
                                    click function (_self, e)
                                    {
                                          var to = new Date();
                                          var from = to.add(Date.DAY, -1);
                                          
                                          _this.sendReportBtn.sendReport(from, to);
                                    }

                                  ]
                                  text = "Yesterday";
                                },
                                Roo.menu.Item {
                                  listeners [
                                    click function (_self, e)
                                    {
                                          var to = new Date();
                                          var from = to.add(Date.DAY, -6);
                                          
                                          _this.sendReportBtn.sendReport(from, to);
                                    }

                                  ]
                                  text = "Last 7 Days";
                                }
                              ]
                            }
                            listeners [
                              render function (_self)
                              {
                                    _this.sendReportBtn = _self;
                              }

                            ]
                            text = "Send Report";
                            methods [
                              sendReport function(from, to)
                              {
                                    fetch(baseURL + '/Crm/Reports/ActivityHtml?' + new URLSearchParams({
                                        "date[from]": from.format('Y-m-d'),
                                        "date[to]": to.format('Y-m-d')
                                    }))
                                    .then(function(res) {
                                        return res.text();
                                    })
                                    .then(function(html) {
                                        var parser = new DOMParser();
                                        var doc = parser.parseFromString(html, 'text/html');
                                        var firstH2 = doc.querySelector('h2');
                                        var subject = firstH2 ? firstH2.textContent : '';
                                        
                                        new Pman.Request({
                                            url: baseURL + '/Roo/Crm_person.php',
                                            method: 'GET',
                                            params: {
                                                _from_group: 'CRM Activity Report',
                                                _include_owner_contacts: 1
                                            },
                                            success: function(r) {
                                                var to = [];
                                                Roo.each(r.data, function(p) {
                                                    to.push({
                                                        id: p.id,
                                                        name: p.name,
                                                        email: p.email,
                                                        tbl: 'crm_person'
                                                    });
                                                });
                                                
                                                Pman.Dialog.MailCreateB.show({
                                                    to: to,
                                                    'subject': subject,
                                                    'body_html': html
                                                });
                                            }
                                        });
                                    });
                              }

                            ]
                          }
                        ]
                        pageSize = 25;
                      }
                      toolbar = Roo.Toolbar {
