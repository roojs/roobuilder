                                    data = [
     [ 'valid', "Valid" ],
     [ 'working', "Working" ],
     [ 'email_failure', "Too Many Failures" ],
     [ 'bad_domain', "Invalid (Bad Domain)" ]
]                                    fields = [ 'key', 'value'];
                                  }
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.emailValidityCombo = _self;
                                          _self.setFromData({
                                              'key': 'valid',
                                              'value': 'Valid'
                                          });
                                    }
,
                                    select function (combo, record, index)
                                    {
                                          if(typeof(_this.deleteAllMatch) != 'undefined') {
                                              // hidden by default
                                              _this.deleteAllMatch.hide();
                                              // shown only when invalid filter is applied
                                              if(['email_failure', 'bad_domain'].includes(record.data.key)) {
                                                  _this.deleteAllMatch.show();
