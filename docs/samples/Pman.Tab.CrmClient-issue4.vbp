                                            _this.search_form.findField('search_company').getValue()
                                        );
                                        
                                    } else {
                                        this.setText("<< Hide Full Search");
                                        _this.filterPanel.region.show();
                                     
                                        //_this.topSearchBox.reset();
                                        _this.topSearchBox.hide();
                                        _this.topSearchBtn.hide();
                                        _this.topSearchClear.hide();
                                         _this.search_form.findField('search_company').setValue(
                                            _this.topSearchBox.getValue()
                                        );
                                    }
                                    
                                    _this.grid.footer.onClick('first');
                                
                              }
,
