                                    reader = Roo.data.JsonReader {
                                      fields = [];
                                      id = "id";
                                      root = "data";
                                      totalProperty = "total";
                                    }
                                    listeners [
                                      load function (_self, records, options)
                                      {
                                            _self.each(function(record){
                                                updated_dt = record.get('updated_dt');
                                                created_dt = record.get('created_dt');
                                                language_name = record.get('language_name');
                                                subject = record.get('subject');
                                                date = (updated_dt > created_dt) ? updated_dt : created_dt;
                                                date = (date.getFullYear() !== 0) ? String.format('{0}', date.format('Y/M')) + ' - ': '';
                                                record.set("message_info", date + language_name + ' - ' + subject);
                                            });
                                      }
,
                                      beforeload function (_self, o)
                                      {
                                            o.params = o.params || {};
                                            // set more here
                                            o.params['_columns'] = 'id,updated_dt,created_dt,language_name,subject';
                                            o.params['_multisort'] = JSON.stringify(
                                                { sort : { 'updated_dt' : 'DESC', 'subject': 'ASC' }, order : [ 'updated_dt', 'subject' ]}
                                            );
                                      }

                                    ]
                                    remoteSort = true;
                                  }
