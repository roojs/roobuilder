                                          _this.dateType = _self;
                                    }
,
                                    select function (combo, record, index)
                                    {
                                          if(combo.getValue()) {
                                              // show date fields
                                              _this.dateRange.show();
                                              if(_this.dateFrom.getValue() || _this.dateTo.getValue()) {
                                                  // refresh if a date range is given
                                                  _this.grid.footer.onClick('first');
                                              }
                                          }
                                          // reset
                                          if(!combo.getValue()) {
                                              // reset date fields
                                              _this.dateFrom.reset();
                                              _this.dateTo.reset();
                                              // hide date fields
                                              _this.dateRange.hide();
                                              // refresh
                                              _this.grid.footer.onClick('first');
                                          }
                                    }

                                  ]
                                  mode = "local";
                                  triggerAction = "all";
                                  valueField = "key";
                                },
                                Roo.form.FieldSet {
                                  String|Object|Function style = "width:205px;";
                                  [
                                    Roo.form.DateField {
                                      Boolean useIso = true;
                                      fieldLabel = "From";
                                      format = "Y-m-d";
                                      listeners [
                                        render function (_self)
                                        {
                                              _this.dateFrom = this;
                                        }
,
                                        select function (combo, date)
                                        {
