                                totalProperty = "total";
                              }
                              listeners [
                                beforeload function (_self, options)
                                {
                                      options.params = options.params || {};
                                      options.params['query[name]'] = _this.companySearchBox.getValue();
                                      options.params._status_filter = _this.companyStatusFilter;
                                      options.params._with_active_contact_count = 1;
                                      options.params._with_owners = 1;
                                      options.params._with_last_contact = 1;
                                      options.params.sort = 'name';
                                      options.params.dir = 'ASC';
                                      options.params._skip_country_display_name = 1;
                                      options.params._skip_comptype_display_name = 1;
                                }

                              ]
                              remoteSort = true;
                            }
                            footer = Roo.PagingToolbar {
                              displayInfo = true;
                              displayMsg = "Displaying Company {0} - {1} of {2}";
                              emptyMsg = "No company found";
                              [
                                Roo.Toolbar.Button {
                                  menu = Roo.menu.Menu {
                                    [
                                      Roo.menu.Item {
                                        String text = "Show duplicated companies list";
                                        listeners [
                                          click function (_self, e)
                                          {
                                                _this.companyStatusBtn.setText(this.text.replace("Show", "Showing"));
                                                _this.companyStatusFilter = 'duplicate';
                                                _this.companyGrid.footer.onClick('first');
                                          }

                                        ]
                                      },
                                      Roo.menu.Item {
                                        String text = "Show deleted";
                                        listeners [
                                          click function (_self, e)
                                          {
                                                _this.companyStatusBtn.setText(this.text.replace("Show", "Showing"));
                                                _this.companyStatusFilter = 'deleted';
                                                _this.companyGrid.footer.onClick('first');
                                          }

                                        ]
                                      },
                                      Roo.menu.Item {
                                        String text = "Show all";
                                        listeners [
                                          click function (_self, e)
                                          {
                                                _this.companyStatusBtn.setText(this.text.replace("Show", "Showing"));
                                                _this.companyStatusFilter = 'all';
                                                _this.companyGrid.footer.onClick('first');
                                          }

                                        ]
                                      }
                                    ]
                                  }
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.companyStatusBtn = _self;
                                          _this.companyStatusFilter = 'all';
                                    }

                                  ]
                                  text = "Showing all";
                                }
                              ]
                              pageSize = 25;
                            }
                            toolbar = Roo.Toolbar {
                              [
                                Roo.form.TextField {
                                  Number width = 100;
                                  String emptyText = "Search name";
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.companySearchBox = this;
                                    }
,
                                    specialkey function (_self, e)
                                    {
                                          if (e.getKey() == 13) {
                                              _this.companyGrid.footer.onClick('first');
                                          }
                                    }

                                  ]
                                },
                                Roo.Toolbar.Button {
                                  icon = rootURL + '/Pman/templates/images/search.gif';
                                  cls = "x-btn-text-icon";
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.companySearchBtn = _self;
                                    }
,
                                    click function (_self, e)
                                    {
                                          _this.companyGrid.footer.onClick('first');
                                    }

                                  ]
                                  text = "Search";
                                },
                                Roo.Toolbar.Button {
                                  icon = rootURL + '/Pman/templates/images/edit-clear.gif';
                                  cls = "x-btn-icon";
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.companySearchClear = _self;
                                    }
,
                                    click function (_self, e)
                                    {
                                          // reset company grid
                                          _this.companySearchBox.reset();
                                          _this.companyGrid.footer.onClick('first');
                                          
                                          // reset company combo in advanced search
                                          _this.companySel.setFromData({});
                                          
                                          // reload person grid
                                          _this.companyGrid.getSelectionModel().clearSelections();
                                          _this.grid.footer.onClick('first');
                                    }

                                  ]
                                },
                                Roo.Toolbar.Fill {},
                                Roo.Toolbar.Button {
                                  listeners [
                                    click function (_self, e)
                                    {
                                          var s = _this.companyGrid.getSelectionModel().getSelections();
                                              
                                          if(typeof(s) === 'undefined' || !s.length) {
                                              Roo.MessageBox.alert('Error', 'Please select at least one company');
                                              return;
                                          }
                                          
                                          var mergeFromIds = [];
                                          var mergeFromNames = [];
                                          
                                          Roo.each(s, function(company) {
                                              mergeFromIds.push(company.data.id);
                                              mergeFromNames.push(company.data.name);
                                          });
                                          
                                          Pman.Dialog.CrmMergeCompany.show({
                                              'merge_from_id': mergeFromIds.join(','),
                                              'merge_from_name_arr': mergeFromNames
                                          }, function() {
                                              _this.companyGrid.footer.onClick('refresh');
                                              _this.grid.footer.onClick('first');
                                          });
                                    }

                                  ]
                                  text = "Merge";
                                },
                                Roo.Toolbar.Button {
                                  icon = rootURL + '/Pman/templates/images/trash.gif';
                                  cls = "x-btn-text-icon";
                                  listeners [
                                    render function (_self)
                                    {
                                          _this.companyDeleteBtn = _self;
                                    }
,
                                    click function()
                                    {
                                          var s = _this.companyGrid.getSelectionModel().getSelections();
                                              
                                          if(typeof(s) === 'undefined' || !s.length) {
                                              Roo.MessageBox.alert('Error', 'Please select at least one company');
                                              return;
                                          }
                                          
                                          var ids = [];
                                          
                                          Roo.each(s, function(company) {
                                              ids.push(company.data.id);
                                          });
                                          
                                          Roo.MessageBox.confirm("Confirm", "Are you sure you want to delete the company and it's contacts?", function(r) {
                                              if (r!='yes') {
                                                  return;
                                              }
                                              
                                              new Pman.Request({
                                                  url : baseURL + '/Roo/Core_company',
                                                  method : 'POST',
                                                  params : {
                                                      _flag_company_and_contacts_deleted: ids.join(',')
                                                  },
                                                  success : function(res){
                                                      _this.companyGrid.footer.onClick('refresh');
                                                      _this.grid.footer.onClick('first');
                                                  }
                                              });
                                          });
                                          
                                          return;
                                    }

                                  ]
                                  text = "Delete";
                                }
                              ]
                            }
                            cm[] = Roo.grid.ColumnModel {
                              renderer = function(v, x, r) 
                              {
                                    // deleted: light grey + strike through
                                    if(r.data.deleted_by * 1) {
                                        return String.format("<s style='color:lightgrey;'>{0}</s>", v);
                                    }
                                    
                                    // is one of the owner: black bold
                                    if(r.data.is_owner * 1) {
                                        return String.format("<b style='color:black;'>{0}</b>", v);
                                    }
                                    
                                    return String.format('{0}', v); 
                              }
                              dataIndex = "name";
                              header = "Name";
                              sortable = true;
                              width = 100;
                            }
                            cm[] = Roo.grid.ColumnModel {
                              renderer = function(v, x, r) 
                              {
                                    return String.format('{0}', v); 
                              }
                              dataIndex = "active_contact_count";
                              header = "Contacts";
                              sortable = true;
                              width = 75;
                            }
                            cm[] = Roo.grid.ColumnModel {
                              renderer = function(v, x, r) 
                              {
                                    return String.format('{0}', v); 
                              }
                              dataIndex = "comptype_id_display_name";
                              header = "Comptype";
                              sortable = true;
                              width = 125;
                            }
                            cm[] = Roo.grid.ColumnModel {
                              renderer = function(v, x, r) 
                              {
                                    return (r.data.no_active_contact * 1 ? '<i class="crm-red">' : '<i>') 
                                        + r.data.contact_owners 
                                        + '</i>';
                              }
                              dataIndex = "contact_owners";
                              header = "Owners";
                              sortable = true;
                              width = 120;
                            }
                            cm[] = Roo.grid.ColumnModel {
                              renderer = function(v, x, r) 
                              {
                                    var lastContactDate = Date.parseDate(r.data.last_contact, "Y-m-d H:i:s");
                                    if (!lastContactDate || lastContactDate < Date.parseDate("2000-01-01", "Y-m-d")) {
                                        return '';
                                    }
                                    
                                    var diff = lastContactDate.getElapsed(new Date(), Date.DAY);
                                    var monthDiff = Math.floor(diff / 30);
                                    var yearDiff = Math.floor(diff / 365);
                                    
                                    var ret = diff + ' days';
                                    
                                    // >= 2 months
                                    if(monthDiff >= 2) {
                                        ret = monthDiff + ' months';
                                    }
                                    // >= 1 year
                                    if(yearDiff >= 1) {
                                        ret = yearDiff + ' year' + (yearDiff > 1 ? 's' : '');
                                    }
                                    
                                    return String.format('{0}', ret); 
                              }
                              dataIndex = "last_contact";
                              header = "Last Contact";
                              sortable = true;
                              width = 100;
                            }
                            listeners [
                              render function (grid)
                              {
                                    _this.companyGrid = this;
                              }
,
                              rowclick function (_self, rowIndex, e)
                              {
                                    var record = this.getDataSource().getAt(rowIndex);
                                    
                                    _this.companySel.setFromData(record.data);
                                    _this.grid.footer.onClick('first');
                              }
,
                              rowdblclick function (_self, rowIndex, e)
                              {
                                    var record = this.getDataSource().getAt(rowIndex);
                                    
                                    Pman.Dialog.CrmCompany.show( { id : record.data.id } , function(res) {
                                        _this.companyGrid.footer.onClick('first');
                                   }); 
                              }

                            ]
                            loadMask = true;
                          }
                          listeners [
