                                          return false;
                                      
                                      }
                                        
                                      
                                      if (action.type =='submit') {
                                           _this.uploadForm.reset();
                                             _this.uploadSending = false;
                                            _this.uploadForm.el.unmask();         
                                            _this.imageView.loadImages();
                                           return;
                                      }
                                       
                                }
,
