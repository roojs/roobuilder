namespace JsRender
{
	public abstract class NodeBase : GLib.Object, Json.Serializable
	{
		// Core properties
		public int oid { get; private set; default = -1; }
		public Node? parent { get; set; default = null; }
		public JsRender? file { get; set; default = null; }
		
		// New properties as requested
		public Gee.ArrayList<Node> children { get; private set; default = new Gee.ArrayList<Node>(); }
		public Gee.ArrayList<NodeProp> properties { get; private set; default = new Gee.ArrayList<NodeProp>(); }
		
		// Static counter for unique IDs
		public static int uid_count = 0;
		
		// Constructor
		protected NodeBase( )
		{
			// Properties are initialized with default values
			this.oid = uid_count++;
			
		}
		
		// Note: getter/setter methods are automatically generated by Vala for properties
		
		// Json.Serializable implementation
		public new void Json.Serializable.set_property (ParamSpec pspec, Value value) {
			base.set_property (pspec.get_name (), value);
		}

		public new Value Json.Serializable.get_property (ParamSpec pspec) {
			Value val = Value (pspec.value_type);
			base.get_property (pspec.get_name (), ref val);
			return val;
		}

		public unowned ParamSpec? find_property (string name) {
			return this.get_class ().find_property (name);
		}

		public Json.Node serialize_property (string property_name, Value value, ParamSpec pspec) {
			switch (property_name) {
				case "children":
					var node = new Json.Node (Json.NodeType.ARRAY);
					node.init_array (new Json.Array ());
					var array = node.get_array ();
					foreach (var child in this.children) {
						array.add_element (Json.gobject_serialize (child as NodeBase));
					}
					return node;
				case "properties":
					var node = new Json.Node (Json.NodeType.ARRAY);
					node.init_array (new Json.Array ());
					var array = node.get_array ();
					foreach (var prop in this.properties) {
						array.add_element (Json.gobject_serialize (prop));
					}
					return node;
				case "oid":
					return default_serialize_property (property_name, value, pspec);
				 
				default:
					// Skip properties that don't belong to NodeBase
					return null;
			}
		}

		public bool deserialize_property (string property_name, out Value value, ParamSpec pspec, Json.Node property_node) 
		{
			switch (property_name) {
				case "children":
					value = GLib.Value (typeof(Gee.ArrayList));
					if (property_node.get_node_type () != Json.NodeType.ARRAY) {
						value.set_object(new Gee.ArrayList<Node>());
						return false;
					}
					var children_list = new Gee.ArrayList<Node>();
					property_node.get_array ().foreach_element ((array, index, element) => {
						var child = Json.gobject_deserialize (typeof (Node), array.get_element(index)) as Node;
						if (child != null) {
							// If child oid is negative, assign a new one
							if (child.oid < 0) {
								child.oid = uid_count++;
							}
							child.parent = this as Node;
							children_list.add(child);
						}
					});
					value.set_object(children_list);
					return true;
				case "properties":
					value = GLib.Value (typeof(Gee.ArrayList));
					if (property_node.get_node_type () != Json.NodeType.ARRAY) {
						value.set_object(new Gee.ArrayList<NodeProp>());
						return false;
					}
					var properties_list = new Gee.ArrayList<NodeProp>();
					property_node.get_array ().foreach_element ((array, index, element) => {
						var prop = Json.gobject_deserialize (typeof (NodeProp), array.get_element(index)) as NodeProp;
						if (prop != null) {
							prop.parent = this as Node; // Set parent after deserializing
							properties_list.add(prop);
						}
					});
					value.set_object(properties_list);
					return true;
				case "oid":
					// Handle oid deserialization
					value = GLib.Value (typeof(int));
					if (property_node.get_node_type () == Json.NodeType.VALUE) {
						var oid_value = (int) property_node.get_int();
						value.set_int(oid_value);
						// If oid is negative, assign a new one from static counter
						if (oid_value < 0) {
							value.set_int(uid_count++);
						}
						return true;
					}
					// If not a valid value, assign new oid
					value.set_int(uid_count++);
					return true;
				case "parent":
		            return false;
				case "file":
					// For other NodeBase properties, use default deserialization
					return default_deserialize_property (property_name, out value, pspec, property_node);
				default:
					// Skip properties that don't belong to NodeBase
					value = GLib.Value (pspec.value_type);
					return false;
			}
		}
	}
}
