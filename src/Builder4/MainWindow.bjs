         "listeners" : {
          "clicked" : [
           "( ) => {",
           "",
           "",
           "\t// fixme - need to handle code",
           "\t",
           "\t// from tree => collapse",
           "\t// dont save the width",
           "\tif (!_this.btn_full.el.visible) {",
           "\t\t// then it's a full window",
           "\t\t_this.btn_full.last_w = _this.splitview.el.get_width();",
           "\t\t_this.btn_tree.last_w = _this.tree.el.get_width();",
           "\t\t\t",
           "\t} // else  we are tree view..",
           "\t ",
           "\t\t",
           "\t_this.btn_full.last_h = _this.splitview.el.get_height();",
           "\t",
           "",
           "\t _this.splitview.el.height_request = _this.btn_full.last_h;",
           "\t// _this.el.close_request();",
           "\t_this.splitview.el.hide();",
           "\t _this.btn_tree.el.show();",
           "\t_this.btn_full.el.show();",
           "\t_this.btn_header.el.hide();",
           " ",
           "\t",
           "\t// we need to work out",
           "\tint x,y;",
           "\tuint w,h;",
           "\tif (!_this.getSize(out x, out y, out w, out h)) {",
           "\t\treturn;",
           "\t}",
           "\t",
           "\th -= _this.btn_full.last_h;",
           "\t",
           "\t//_this.el.set_default_size(-1,0);",
           "\t_this.setSize(x,y, w, h);",
           "\t",
           "\t// load it everywhere",
           "}",
           ""
          ]
