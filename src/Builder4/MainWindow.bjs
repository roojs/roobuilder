           "\t",
           "\t\tint x,y;",
           "\tuint w,h;",
           "\tif (!_this.getSize(out x, out y, out w, out h)) {",
           "\t\treturn;",
           "\t}",
           "",
           "\tif (_this.btn_header.el.visible) {",
           "\t\t// then wer are not full... only",
           "\t\tvar tree = _this.windowstate.left_tree;",
           "\t\t",
           "\t ",
           "\t\t_this.btn_full.last_w = _this.splitview.el.get_width();",
           "",
           "\t\t",
           "\t\t_this.last_w = tree.viewwin.el.get_width(",
           "\t\t_this.btn_full.last_h = _this.splitview.el.get_height();",
           "\t\t ",
           "\t\t",
           "\t} else {",
           "\t\t// we are in header collapse - no valuable data available.?",
           "\t\t// techmically we could store the width?",
           "\t}",
           "\t",
           "\t_this.label_project.el.hide();",
           "\t_this.label_file.el.hide();",
           "\t_this.splitview.el.show();",
           "\t_this.rightpane.el.hide();",
           " \t_this.props.el.hide();",
           "\t_this.btn_tree.el.hide();",
           "\t_this.btn_full.el.show();",
           "\t_this.btn_header.el.show();",
           "\t",
           "\t",
           "\tGLib.debug(\"Set size %d x %d\", this.last_w, _this.btn_full.last_h);",
           "\t",
           "\t_this.el.set_default_size(this.last_w, _this.btn_full.last_h);",
           "\t",
           "\t//// what size is the ",
           "",
           "\t// load it everywhere",
           "}",
