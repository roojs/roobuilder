   "string title" : "Roo Application Builder",
   "xtype" : "ApplicationWindow",
   "| bool getSize" : [
    "(out int x, out int y, out uint w, out uint h) {",
    "",
    "\tvar s =  this.el.get_surface() as Gdk.X11.Surface;",
    "\tvar xw = s.get_xid();",
    "\t",
    "\tvar di = (Gdk.X11.Display) s.get_display() ;",
    "\tif (di == null) {",
    "\t\treturn false; // no change",
    "\t}",
    "\tX.WindowAttributes wa;\t\t",
    "\tunowned X.Display xd =  (X.Display) di.get_xdisplay();\t",
    "",
    "\txd.get_window_attributes(xw, out  wa);",
    "\tx = wa.x;",
    "\ty = wa.y;",
    "\tw = wa.width;",
    "\th = wa.height;",
    "\t",
    "\tGLib.debug(\"Get size %d,%d %dx%d\", x,y, (int)w, (int)h);",
    "\t// we don't set last_x/y (as the save code needs the old info to compare.",
    "\t",
    "\treturn true;",
    "}"
   ],
   "| void initChildren" : [
    " () {",
    "    // this needs putting in a better place..",
    "    if (this.windowstate == null) {",
    "    \tthis.windowstate = new WindowState(this);",
    "    ",
    "    }",
    "     ",
    "",
    " ",
    "",
    "    ",
    "",
    "",
    "",
    "}",
    ""
   ],
   "| void openNewWindow" : [
    "() {",
    " ",
    "    var w = new Xcls_MainWindow();",
    "    w.ref();",
    "\tWindowManager.add(w);",
    "    w.el.show();",
    "    w.initChildren();",
    "    w.windowstate.showPopoverFiles(w.open_projects_btn.el, _this.project, false);",
    "     ",
    "}",
    ""
   ],
   "| void setSize" : [
    "(int x, int y, uint w, uint h) {",
    "",
    "",
    "",
    "\tvar s = this.el.get_surface() as Gdk.X11.Surface;",
    "\tvar xw = s.get_xid();",
    "\t",
    "\tvar di = s.get_display() as Gdk.X11.Display;",
    "\t",
    "\tunowned X.Display xd = di.get_xdisplay();",
    "\tif (w >0 && h > 0) {",
    "\t\txd.move_resize_window(xw, x,y, w, h);",
    "\t} else {",
    "\t\txd.move_window(xw, x,y);",
    "\t}",
    "\tX.WindowAttributes wa;",
    "\txd.get_window_attributes(xw, out  wa);",
    "\t",
    "\t",
    "\tGLib.debug(\"Move to %d, %d %dx%d\",  x,y, (int) w, (int)h);",
    "\tthis.last_x = x;",
    "\tthis.last_y = y;",
    "",
    "\tthis.last_w = w > 0 ? w : (uint)wa.width;",
    "\t ",
    "\tthis.last_h = h > 0 ? h : (uint)wa.height;",
    "",
    "}"
   ],
   "| void setTitle" : [
    " () {",
    "    if (_this.windowstate.project == null || ",
    "\t    _this.windowstate.file == null",
    "    ) {",
    "    \tthis.el.set_title(\"Select File\");",
    "    \treturn;",
    "\t}",
    "    _this.el.set_title(",
    "    \t_this.windowstate.project.name + ",
    "    \t\" - \" +",
    "\t\t_this.windowstate.file.relpath);",
    "} "
   ],
   "| void show" : [
    "() {",
    "   ",
    "    this.el.show();",
    "    if (this.windowstate.file  == null) {",
    "    \tthis.windowstate.showPopoverFiles(this.open_projects_btn.el, null, false);",
    "    }",
    "}"
   ],
   "| void updateErrors" : [
    "() {",
    "",
    "",
    " \tGLib.debug(\"updateErrors\");",
    "\t",
    "\tvar pr = this.windowstate.project.getErrors(\"ERR\");",
    "\t",
    "\tthis.statusbar_errors.setNotices(",
    "\t\tpr,",
    "\t\tthis.windowstate.file.getErrorsTotal(\"ERR\")",
    "\t);",
    "\t",
    "\tthis.statusbar_warnings.setNotices(",
    "\t\tthis.windowstate.project.getErrors(\"WARN\"),",
    "\t\tthis.windowstate.file.getErrorsTotal(\"WARN\")",
    "\t);",
    "\tthis.statusbar_depricated.setNotices(",
    "\t\tthis.windowstate.project.getErrors(\"DEPR\"),",
    "\t\tthis.windowstate.file.getErrorsTotal(\"DEPR\")",
    "\t);",
    "",
    "\t_this.statusbar_run.el.hide();",
    "",
    "\tif (pr.get_n_items() < 1) {",
    "\t\t_this.statusbar_run.el.show();",
    "\t} ",
    "\t",
    "}"
   ]
  }
