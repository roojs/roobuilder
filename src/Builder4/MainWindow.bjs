   "listeners" : {
    "close_request" : [
     "( ) => {",
     "\t ",
     "\t if (_this.statusbar.handler_id > -1) {",
     "\t \tResources.singleton().disconnect(_this.statusbar.handler_id);",
     "\t }",
     "\t ",
     "\t this.windowstate.file.getLanguageServer().document_close(",
     "\t \tthis.windowstate.file",
     " \t);",
     "\t ",
     "\t WindowManager.remove(this);",
     "\t WindowManager.save();",
     "\t ",
     "\t if (WindowManager.size()  < 1) {",
     "\t \ttry {",
     "\t\t\tthis.windowstate.file.getLanguageServer().exit();",
     "\t\t} catch(Error e) {}",
     "\t\t",
     "\t\tBuilderApplication.singleton(  null ).quit();",
     "\t }",
     "\treturn true;",
     "\t",
     "}",
     ""
    ],
