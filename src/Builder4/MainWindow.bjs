           "\t}",
           "\tif (!_this.windowstate.file.undoStep(-1)) {",
           "\t\treturn;",
           "\t}",
           "\t",
           "\t ",
           "\t_this.windowstate.switchState (WindowState.State.PREVIEW); ",
           "\t// this triggers loadItems..",
           "\t_this.windowstate.left_tree.model.loadFile(",
