                          {
                            "node-type" : 8,
                            "oid" : 148,
                            "prop-name" : "query_tooltip",
                            "prop-val" : [
                              "(x, y, keyboard_tooltip, tooltip) => {",
                              "\t",
                              "\t//GLib.debug(\"query tooltip\");",
                              "\tGtk.TextIter iter;",
