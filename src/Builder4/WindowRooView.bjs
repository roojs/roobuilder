                            "node-type" : 4,
                            "oid" : 151,
                            "prop-name" : "clearGreySelection",
                            "prop-val" : [
                              "() {",
                              " // clear all the marks..",
                              "    var sbuf = (GtkSource.Buffer)this.el.buffer;",
                              "    ",
                              "    Gtk.TextIter start;",
                              "    Gtk.TextIter end;     ",
                              "        ",
                              "    sbuf.get_bounds (out start, out end);",
