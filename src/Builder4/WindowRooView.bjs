                              "\t\tif (sel_start_iter.get_line() < start_line || sel_end_iter.get_line() > end_line ||",
                              "\t\t\tsel_start_iter.get_line() > end_line   || sel_end_iter.get_line() < start_line\t\t\t) {",
                              "\t\t\t// save?",
