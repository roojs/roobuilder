        "node-type" : 4,
        "oid" : 213,
        "prop-name" : "loadFile",
        "prop-val" : [
          "",
          "(JsRender.JsRender file)",
          "{",
          "    ",
          "    if (this.file ==null || file.path != this.file.path) {",
          "   \t\t this.notebook.el.page = 0;// webkit preview ",
          "    }",
          "    this.file = file;",
          "    this.view.renderJS(true);",
          "   ",
          "    this.sourceview.loadFile();   ",
          "    this.last_error_counter = -1;",
          "    this.updateErrorMarks();",
          "}",
