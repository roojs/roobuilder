                                              "\t\t\t\t\t}",
                                              "\t\t\t\t\tbreak;",
                                              "\t\t\t}",
                                              "\t\t\tif (!cs) {",
                                              "\t\t\t\tcontinue;",
                                              "\t\t\t}",
                                              "\t\t\t",
                                              "\t\t\t",
                                              "\t\t\tif (str.length < 1) {",
                                              "\t\t\t\treturn true;",
                                              "\t\t\t}",
                                              "\t\t\tif (f.name.down().contains(str)) {",
                                              "\t\t\t\treturn true;",
                                              "\t\t\t}",
                                              "\t\t\t",
                                              "\t\t}",
                                              "\t\t ",
                                              "\t\treturn false;",
                                              "\t}",
                                              "\tif (j.xtype != \"PlainFile\") {",
                                              "\t\treturn false;",
                                              "\t}",
                                              " \tif (j.content_type.contains(\"image\")) {",
