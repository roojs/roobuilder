                                              "\t ",
                                              "\tvar j =  (JsRender.JsRender) item;",
                                              " ",
                                              "\tvar str = _this.searchbox.el.text.down();\t",
                                              "\tGLib.debug(\"filter %s to %s\" , str, j.name.down());",
                                              "\t",
                                              "\tif (!_this.filter_symlink.el.active) {",
                                              "\t\t// hide symlinks",
                                              "\t\tif (j.is_symlink) {",
                                              "\t\t\treturn false;",
                                              "\t\t}",
                                              "\t}",
                                              "\t",
                                              "\tif (str.length < 1) { // no search.",
                                              "\t\treturn true;",
                                              "\t}",
                                              "\tif (j.name.down().contains(str)) {",
                                              "\t\treturn true;",
                                              "\t}",
                                              "\treturn false; ",
                                              "",
                                              "}"
