                                        "children" : [
                                          {
                                            "node-type" : 2,
                                            "oid" : 599,
                                            "prop-name" : "match_func",
                                            "prop-val" : [
                                              "(item) => { ",
                                              "\tvar tr = ((Gtk.TreeListRow)item).get_item();",
                                              "\t//GLib.debug(\"filter %s\", tr.get_type().name());",
                                              "\tvar j =  (JsRender.JsRender) tr;",
                                              "\tif (j.xtype == \"Dir\" && j.childfiles.n_items < 1) {",
                                              "\t\treturn false;",
                                              "\t}",
                                              "\tif (!_this.filter_symlink.el.active) {",
                                              "\t\t// hide symlinks",
                                              "\t\tif (j.is_symlink) {",
                                              "\t\t\treturn false;",
                                              "\t\t}",
                                              "\t}",
                                              "\t",
                                              "\tvar str = _this.searchbox.el.text.down();\t",
                                              "\tif (j.xtype == \"Dir\") {",
                                              "\t",
                                              "\t\tfor (var i =0 ; i < j.childfiles.n_items; i++) {",
                                              "\t\t\tvar f = (JsRender.JsRender) j.childfiles.get_item(i);",
                                              "\t\t\tif (f.xtype != \"PlainFile\") {",
                                              "\t\t\t\tcontinue;",
                                              "\t\t\t}",
                                              "\t\t\tif (f.content_type.contains(\"image\")) {",
                                              "\t\t\t\tcontinue;",
                                              "\t\t\t}",
                                              "\t\t\tif (!_this.filter_symlink.el.active) {",
                                              "\t\t\t\t// hide symlinks",
                                              "\t\t\t\tif (f.is_symlink) {",
                                              "\t\t\t\t\tcontinue;",
                                              "\t\t\t\t}",
                                              "\t\t\t}",
                                              "\t\t\tvar cs = false;",
                                              "\t\t\tswitch(f.file_ext.down()) {",
                                              "\t\t\t\tcase \"php\":",
                                              "\t\t\t\t\tif (_this.filter_php.el.active) {",
                                              "\t\t\t\t\t\tcs = true;",
                                              "\t\t\t\t\t}",
                                              "\t\t\t\t\tcontinue;",
                                              "\t\t\t\tcase \"vala\":",
