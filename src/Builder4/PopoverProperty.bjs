                    "prop-name" : "clicked",
                    "prop-val" : [
                      "() => {",
                      "\tif (!_this.is_new) {",
                      "\t\t_this.el.hide();",
                      "\t\treturn; // hide() picks up update",
                      "\t}",
                      "\t",
                      "\t// check if text is not empty..",
                      "\tif ( _this.kname.el.get_text().strip().length < 1) {",
                      "\t",
                      "\t\t// error should already be showing?",
                      "\t\treturn;",
                      "\t}",
                      "\t ",
                      "\t// since we can't add listeners?!?!?",
                      "\t// only check props.",
                      "\t// check if property already exists in node.\t",
                      "",
                      "",
                      "\tvar prop = new JsRender.NodeProp(",
                      "\t\t_this.kname.el.get_text().strip(),",
                      "\t\t_this.ptype.getValue(),",
                      "\t\t_this.ktype.el.get_text().strip(),",
                      "\t\t_this.prop.prop_val",
                      "\t);",
                      "",
                      "\t// apply async flag for Vala methods if visible",
                      "\tif (_this.is_async.el.get_visible()) {",
                      "\t\tprop.modify_is_async(_this.is_async.el.active);",
                      "\t}",
                      "",
                      "\tif (_this.node.has_property_key(prop)) {",
                      "\t\t_this.error.setError(\"Property already exists\");",
                      "\t\treturn;\t",
                      "\t}",
                      "\t",
                      "\t",
                      "\t",
                      "\t_this.node.file.action_manager.run(new JsRender.Action.Add.from_node(",
                      "\t\t_this.node.file,",
                      "\t\tprop,",
                      "\t\t_this.node,",
                      "\t\t",
                      "\t\t-1",
                      "\t));",
                      "\t// hide self",
                      "\t_this.prop = null; // skip checks..",
                      "\t_this.is_new = false;",
                      "\t_this.el.hide();",
                      " \t_this.mainwindow.windowstate.left_props.changed();",
                      "\t_this.mainwindow.windowstate.left_props.view.editProp(prop);",
                      "",
                      "\t",
                      "\t",
                      "}"
                    ]
                  },
