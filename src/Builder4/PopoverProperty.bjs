                "prop-val" : [
                  "(string err)   {",
                  "\tif (err == \"\") {",
                  "\t\tthis.el.label = \"\";",
                  "\t} else {",
                  "",
                  "\t\t",
                  "\t\tthis.el.label = \"<span color=\\\"red\\\">\" + err + \"</span>\";",
