                "prop-val" : [
                  "(JsRender.NodePropType ty) {",
                  "\tvar str = ty.to_name();",
                  "\tvar sl = this.el.model as Gtk.StringList;",
                  "\tfor(var i = 0; i < sl.get_n_items(); i++) {",
                  "\t\tif(sl.get_string(i) == str) {",
                  "\t\t\tthis.el.set_selected(i);",
                  "\t\t\tbreak;",
