{
    "app-id": "org.roojs.roobuilder",
    "runtime": "org.gnome.Sdk",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "roobuilder",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--filesystem=home"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/vala"
    ],
    "modules": [
         {
            "name": "roojspacker",
            "buildsystem" : "meson",
            "builddir" : true,
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/roojs/roojspacker.git",
                    "tag": "release-1.5.2",
                    "commit": "9e80138b4a487cf4d7364d8aa055fe78a06edd31"
                }
            ]
        },
        {
            "name": "roobuilder",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/roojs/roobuilder.git",
                    "tag": "release-5.0.11",
                    "commit": "f1f01d604703aa7f4bf38a6c0735964e36e85667"
                }
            ]
        }
    ]
}
